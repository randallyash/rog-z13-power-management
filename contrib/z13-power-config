#!/bin/bash
#
# z13-power-config — deploy the packaged KDE PowerDevil config (display/DPMS only).
#
# Writes ~/.config/powerdevilrc from the system template
# (/usr/share/z13-power-management/powerdevilrc), backing up any existing file.
#
# Power profile switching is handled by the z13-power-service tray app, not by
# KDE Run Script hooks — nothing else needs configuring in KDE.
#
# Usage:  z13-power-config

set -euo pipefail

SRC="/usr/share/z13-power-management/powerdevilrc"
TARGET="$HOME/.config/powerdevilrc"

[[ -f "$SRC" ]] || { echo "z13-power-config: $SRC not found (package broken?)" >&2; exit 1; }
mkdir -p "$HOME/.config"
if [[ -f "$TARGET" ]]; then
  cp "$TARGET" "$TARGET.bak.$(date +%Y%m%d%H%M%S)"
  echo "Backed up $TARGET"
fi
cp "$SRC" "$TARGET"
cat <<'EOF'
Deployed KDE PowerDevil display/DPMS settings to ~/.config/powerdevilrc.

Profile switching is owned by the z13-power tray service — enable it with:
  systemctl --user enable --now z13-power-service
EOF
