# z13-power: the SMU mailbox stays root-only.
# ryzen_smu does not check the caller. A world-writable mailbox or smn lets
# any local account skip the wattage and voltage checks. z13-power-smu is
# the only writer, and it accepts only clamped PPT and curve-optimizer values.
ACTION=="add", SUBSYSTEM=="module", KERNEL=="ryzen_smu", RUN+="/usr/lib/z13-power/lock-smu-sysfs"
