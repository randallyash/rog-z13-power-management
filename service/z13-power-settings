    def showEvent(self, event):
        super().showEvent(event)
        if not getattr(self, "_loaded", False):
            self._loaded = True
            self._fill_lottery()
            self.refresh()

    def _fill_lottery(self):
        lot = silicon_lottery()
        if not lot:
            self.lottery.set_value("unavailable")
            self.suggest.set_value("—")
            return
        self.lottery.set_value(
            "%d / 100   (best core %d · weakest core %d)" % (
                lot["score"], lot["best"], lot["worst"]))
        if lot["suggest"] == 0:
            self.suggest.set_value("Stock — step in −5 mV if you want to try")
        else:
            self.suggest.set_value(
                "%d mV  (starting point; step by 5 mV and test)" % lot["suggest"])

    def _uv_label(self, n):
        self.uv_value.setText("Stock" if n == 0 else "-%d mV" % n)

    def _uv_maybe_apply(self, _n):
        if not self.uv_slider.isSliderDown():
            self.apply_undervolt()

    def apply_undervolt(self):
        mag = self.uv_slider.value()
        val = 0 if mag == 0 else -mag
        if getattr(self, "_uv_applied", None) == val and ryzen_smu_loaded():
            return
        self._uv_applied = val
        save_undervolt(val)
        if not ryzen_smu_loaded():
            self.msg.set_result(
                False,
                "Saved — needs ryzen_smu (paru -S ryzen_smu-dkms-git, amkillam fork) "
                "before it can apply")
            return
        if val == 0:
            r = z13ctl(["undervolt", "--reset"])
        else:
            r = z13ctl(["undervolt", "--set", str(val)])
        ok = r is not None and r.returncode == 0
        self.msg.set_result(
            ok,
            "Undervolt %s." % ("stock" if val == 0 else "%d mV" % val)
            if ok else (r.stderr.strip() if r is not None else "z13ctl failed"))

    def refresh(self):
        raw = _read_sysfs(os.path.join(ASUS_WMI, "panel_od"))
        if raw is not None:
            self.panel.setChecked(raw == "1")
        else:
            r = z13ctl(["paneloverdrive", "--get"])
            if r is not None:
                self.panel.setChecked(r.stdout.strip() == "1")
        raw = _read_sysfs(os.path.join(ASUS_WMI, "boot_sound"))
        if raw is not None:
            self.boot.setChecked(raw == "1")
        else:
            r = z13ctl(["bootsound", "--get"])
            if r is not None:
                self.boot.setChecked(r.stdout.strip() == "1")
        saved = load_undervolt()
        if saved is not None:
            mag = abs(int(saved))
            self.uv_slider.blockSignals(True)
            self.uv_slider.setValue(mag)
            self.uv_slider.blockSignals(False)
            self._uv_label(mag)
        if not ryzen_smu_loaded():
            self.uv_note.setText(
                "ryzen_smu is not loaded — the slider still saves. Run: "
                "z13-power setup-undervolt  (installs this kernel's -headers "
                "and ryzen_smu-dkms-git).")
        else:
            self.uv_note.setText(
                "All-core Curve Optimizer (0 to -40 mV). "
                "Re-applied at login and after every profile switch.")

    def apply_panel(self):
        nxt = not self.panel.isChecked()
        val = "1" if nxt else "0"
        ok = _write_sysfs(os.path.join(ASUS_WMI, "panel_od"), val)
        if not ok:
            r = z13ctl(["paneloverdrive", "--set", val])
            ok = r is not None and r.returncode == 0
        if ok:
            self.panel.setChecked(nxt)
        self.msg.set_result(ok, "Panel overdrive updated." if ok else
                            "Failed to set panel overdrive.")

    def apply_boot(self):
        nxt = not self.boot.isChecked()
        val = "1" if nxt else "0"
        ok = _write_sysfs(os.path.join(ASUS_WMI, "boot_sound"), val)
        if not ok:
            r = z13ctl(["bootsound", "--set", val])
            ok = r is not None and r.returncode == 0
        if ok:
            self.boot.setChecked(nxt)
        self.msg.set_result(ok, "Boot sound updated." if ok else
                            "Failed to set boot sound.")


