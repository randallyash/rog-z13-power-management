    def showEvent(self, event):
        super().showEvent(event)
        if not getattr(self, "_loaded", False):
            self._loaded = True
            self.refresh()

    def refresh(self):
        live = None
        raw = _read_sysfs(BAT_LIMIT_PATH)
        try:
            live = int(raw)
        except (TypeError, ValueError):
            r = z13ctl(["batterylimit", "--get"])
            if r is not None and r.stdout.strip():
                try:
                    live = int(r.stdout.strip())
                except ValueError:
                    pass
        saved = load_charge_limit()
        val = live if live is not None else saved
        if val is not None:
            self.slider.blockSignals(True)
            self.slider.setValue(val)
            self.slider.blockSignals(False)
            self.value_label.setText("%d%%" % val)
            self._sync_preset(val)
            self.current.set_value(f"{val}%")
            return
        self.current.set_value("unknown")

    def _sync_preset(self, val):
        key = str(int(val))
        if key in ("60", "80", "100"):
            self.presets.set_value(key)
            return
        for pill in self.presets._pills.values():
            pill.setChecked(False)

    def _on_preset(self, value):
        self.slider.setValue(int(value))
        self.apply()

    def apply(self):
        val = self.slider.value()
        save_charge_limit(val)
        if load_fill_once():
            self.msg.set_result(
                True,
                "Saved %d%%. Filling to 100%% this plug-in, then that cap returns."
                % val)
            self.refresh()
            return
        ok = _write_sysfs(BAT_LIMIT_PATH, val)
        if not ok:
            r = z13ctl(["batterylimit", "--set", str(val)])
            ok = r is not None and r.returncode == 0
        self.msg.set_result(ok, f"Charge limit set to {val}%." if ok else
                            "Failed to set the charge limit.")
        self.refresh()


