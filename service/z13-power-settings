        state_dir = os.path.dirname(STATUS_PATH)
        if os.path.isdir(state_dir):
            self._status_watch.addPath(state_dir)
        if os.path.exists(STATUS_PATH):
            self._status_watch.addPath(STATUS_PATH)
        self._status_watch.fileChanged.connect(self._on_status_changed)
        self._status_watch.directoryChanged.connect(self._on_status_changed)

    def _on_status_changed(self, _path=""):
        if os.path.exists(STATUS_PATH) and STATUS_PATH not in self._status_watch.files():
            self._status_watch.addPath(STATUS_PATH)
        self._refresh_hero()

    def _scroll(self, widget):
        area = QScrollArea()
        area.setWidgetResizable(True)
        area.setFrameShape(QFrame.Shape.NoFrame)
        area.setHorizontalScrollBarPolicy(Qt.ScrollBarPolicy.ScrollBarAlwaysOff)
        area.setWidget(widget)
        return area

    def _refresh_hero(self):
        st = read_status_file()
        tdp = st.get("tdp")
        label = st.get("label") or st.get("mode") or ""
        meta = str(label) if label else "Z13 power"
        if st.get("automatic") is True:
            meta = f"{meta} · automatic"
        elif st.get("locked") is True:
            meta = f"{meta} · locked"
        self.hero.set_meta(meta)
        self.hero.set_detail("" if tdp in (None, "") else f"{tdp}W")

    def apply_theme(self, theme):
        self.theme = theme
        T = _theme_mod()
        T._apply_children(self, theme)
        self._sep.setStyleSheet(f"background: {theme['control_border']};")


def main():
    app = QApplication(sys.argv)
    app.setApplicationName("z13-power-settings")
    app.setDesktopFileName("z13-power-settings")
    theme_mod = _theme_mod()
    theme = theme_mod.load_theme()
    try:
        theme_mod.apply_to_app(app, theme)
        watcher = theme_mod.ThemeWatcher(app)
        watcher.changed.connect(lambda: _reload_theme(app, theme_mod))
        app._theme_watcher = watcher
    except Exception:
        pass
    win = SettingsWindow(theme)
    app._settings_win = win
    win.show()
    return app.exec()


def _reload_theme(app, theme_mod):
    theme = theme_mod.apply_to_app(app)
    win = getattr(app, "_settings_win", None)
    if win is not None:
        win.apply_theme(theme)


if __name__ == "__main__":
    sys.exit(main())
