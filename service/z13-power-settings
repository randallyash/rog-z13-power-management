        self.save_btn = T.Pill("Save", theme)
        self.save_btn.setCheckable(False)
        self.save_btn.clicked.connect(self.save)
        self.open_btn = T.Pill("Open config file…", theme)
        self.open_btn.setCheckable(False)
        self.open_btn.clicked.connect(self.open_config)
        buttons.addWidget(self.save_btn)
        buttons.addWidget(self.open_btn)
        v.addLayout(buttons)

        self.msg = T.StatusLine(theme)
        v.addWidget(self.msg)
        v.addStretch(1)
        self.refresh()

    def refresh(self):
        cfg = load_service_config()
        self.on_ac.set_value(cfg["on_ac"])
        self.on_battery.set_value(cfg["on_battery"])
        self.on_low.set_value(cfg["on_low_battery"])
        try:
            self.threshold.setValue(int(cfg["low_battery"]))
        except ValueError:
            pass

    def save(self):
        updates = {
            "on_ac": self.on_ac.value(),
            "on_battery": self.on_battery.value(),
            "on_low_battery": self.on_low.value(),
            "low_battery": str(self.threshold.value()),
        }
        try:
            save_service_config(updates)
        except OSError as e:
            self.msg.set_result(False, f"Could not write config: {e}")
            return
        self.msg.set_result(True, "Saved — the service reloads config within ~30s.")

    def open_config(self):
        """Open service.conf in $VISUAL/$EDITOR (fallback xdg-open)."""
        editor = os.environ.get("VISUAL") or os.environ.get("EDITOR")
        try:
            if editor:
                subprocess.Popen([editor, CONFIG_PATH])
            else:
                subprocess.Popen(["xdg-open", CONFIG_PATH])
        except OSError:
            self.msg.set_result(False, f"Config: {CONFIG_PATH}")


class SettingsWindow(QMainWindow):
    def __init__(self, theme):
        super().__init__()
        T = _theme_mod()
        self.theme = theme
        self.setWindowTitle("z13-power-settings")
        self.resize(800, 660)
        self.setAttribute(Qt.WidgetAttribute.WA_DeleteOnClose)

        root = QWidget()
        outer = QVBoxLayout(root)
        outer.setContentsMargins(16, 14, 16, 14)
        outer.setSpacing(12)

        self.hero = T.Hero("\uf0e7", "Settings", "Z13 power", theme)
        outer.addWidget(self.hero)
        outer.addWidget(T.HLine(theme))

        body = QHBoxLayout()
        body.setSpacing(16)

        nav = QVBoxLayout()
        nav.setSpacing(4)
        nav.setContentsMargins(0, 0, 0, 0)
        self.nav_items = []
        self.stack = QStackedWidget()
        pages = [
            ("lighting", LightingTab(theme)),
            ("fan", FanTab(theme)),
            ("battery", BatteryTab(theme)),
            ("power", PowerTab(theme)),
            ("profiles", ConfigTab(theme)),
            ("telemetry", TelemetryTab(theme)),
        ]
        self.pages = {}
        for i, (_key, label, glyph) in enumerate(NAV):
            item = T.NavItem(glyph, label, theme)
            item.clicked.connect(lambda _c=False, idx=i: self.stack.setCurrentIndex(idx))
            nav.addWidget(item)
            self.nav_items.append(item)
        for key, widget in pages:
            self.pages[key] = widget
            self.stack.addWidget(self._scroll(widget))
        if self.nav_items:
            self.nav_items[0].setChecked(True)
        nav.addStretch(1)

        nav_wrap = QWidget()
        nav_wrap.setLayout(nav)
        nav_wrap.setFixedWidth(168)
        body.addWidget(nav_wrap)
        sep = QWidget()
        sep.setFixedWidth(1)
        sep.setStyleSheet(f"background: {theme['control_border']};")
        self._sep = sep
        body.addWidget(sep)
        body.addWidget(self.stack, 1)
        outer.addLayout(body, 1)

        self.setCentralWidget(root)
        self._refresh_hero()
        self.hero_timer = QTimer(self)
        self.hero_timer.timeout.connect(self._refresh_hero)
        self.hero_timer.start(2000)

    def _scroll(self, widget):
        area = QScrollArea()
        area.setWidgetResizable(True)
        area.setFrameShape(QFrame.Shape.NoFrame)
        area.setHorizontalScrollBarPolicy(Qt.ScrollBarPolicy.ScrollBarAlwaysOff)
        area.setWidget(widget)
        return area

    def _refresh_hero(self):
        st = read_status_file()
        tdp = st.get("tdp")
        label = st.get("label") or st.get("mode") or ""
        meta = str(label) if label else "Z13 power"
        if st.get("automatic") is True:
            meta = f"{meta} · automatic"
        elif st.get("locked") is True:
            meta = f"{meta} · locked"
        self.hero.set_meta(meta)
        self.hero.set_detail("" if tdp in (None, "") else f"{tdp}W")

    def apply_theme(self, theme):
        self.theme = theme
        T = _theme_mod()
        T._apply_children(self, theme)
        self._sep.setStyleSheet(f"background: {theme['control_border']};")


def main():
    app = QApplication(sys.argv)
    app.setApplicationName("z13-power-settings")
    app.setDesktopFileName("z13-power-settings")
    theme_mod = _theme_mod()
    theme = theme_mod.load_theme()
    try:
        theme_mod.apply_to_app(app, theme)
        watcher = theme_mod.ThemeWatcher(app)
        watcher.changed.connect(lambda: _reload_theme(app, theme_mod))
        app._theme_watcher = watcher
    except Exception:
        pass
    win = SettingsWindow(theme)
    app._settings_win = win
    win.show()
    return app.exec()


def _reload_theme(app, theme_mod):
    theme = theme_mod.apply_to_app(app)
    win = getattr(app, "_settings_win", None)
    if win is not None:
        win.apply_theme(theme)


if __name__ == "__main__":
    sys.exit(main())
