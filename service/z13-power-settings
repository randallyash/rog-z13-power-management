def z13ctl(args, timeout=30):
    """Run a z13ctl command; return the CompletedProcess or None."""
    try:
        return subprocess.run(["z13ctl", *args], capture_output=True,
                              text=True, timeout=timeout)
    except (OSError, subprocess.SubprocessError):
        return None


# ── lighting config ──────────────────────────────────────────────────────────

def load_lighting():
    cfg = configparser.ConfigParser()
    cfg.read(LIGHTING_PATH)
    out = dict(DEFAULT_LIGHTING)
    if cfg.has_section("lighting"):
        for key in out:
            try:
                value = cfg.get("lighting", key).strip()
                if value:
                    out[key] = value
            except configparser.Error:
                pass
    return out


def load_charge_limit():
    cfg = configparser.ConfigParser()
    cfg.read(BATTERY_PATH)
    try:
        val = int(cfg.get("battery", "charge_limit").strip())
    except (configparser.Error, ValueError, OSError):
        return None
    return val if 40 <= val <= 100 else None


def load_fill_once():
    cfg = configparser.ConfigParser()
    cfg.read(BATTERY_PATH)
    try:
        return cfg.getboolean("battery", "fill_once")
    except (configparser.Error, ValueError, OSError):
        return False


def save_charge_limit(val):
    cfg = configparser.ConfigParser()
    cfg.read(BATTERY_PATH)
    if not cfg.has_section("battery"):
        cfg.add_section("battery")
    cfg.set("battery", "charge_limit", str(val))
    os.makedirs(os.path.dirname(BATTERY_PATH), exist_ok=True)
    with open(BATTERY_PATH, "w") as f:
        cfg.write(f)


def load_undervolt():
    """User Tweaks CO offset in mV (0 stock, negative undervolt), or None."""
    cfg = configparser.ConfigParser()
    cfg.read(TWEAKS_PATH)
    try:
        raw = cfg.get("tweaks", "undervolt").strip()
        if raw in ("reset", "stock", ""):
            return 0
        val = int(raw)
    except (configparser.Error, ValueError, OSError):
        return None
    if val > 0:
        val = -val
    return val if -40 <= val <= 0 else None


def save_undervolt(val):
    val = int(val)
    if load_undervolt() == val:
        return
    cfg = configparser.ConfigParser()
    if os.path.exists(TWEAKS_PATH):
        cfg.read(TWEAKS_PATH)
    if not cfg.has_section("tweaks"):
        cfg.add_section("tweaks")
    cfg.set("tweaks", "undervolt", str(val))
    os.makedirs(os.path.dirname(TWEAKS_PATH), exist_ok=True)
    with open(TWEAKS_PATH, "w") as f:
        cfg.write(f)


def ryzen_smu_loaded():
    return os.path.isdir("/sys/kernel/ryzen_smu_drv")


def _bin_score(rank):
    """Map an AMD preferred-core rank (~160–240 on Strix Halo) to 50–99."""
    score = int(round(50 + (float(rank) - 160) * 50 / 80))
    return max(50, min(99, score))


_lottery_cache = None


def silicon_lottery():
    """Approximate silicon quality from AMD CPPC preferred-core rankings.

    ASUS BIOS SP uses fused VID/FIT tables we cannot read from userspace.
    Prefcore ranking is the hardware's own per-core quality order. All
    numbers we show use the same 50–99 scale so the overall score sits
    between best and weakest. Cached for the process — ranks do not change.
    """
    global _lottery_cache
    if _lottery_cache is not None:
        return _lottery_cache or None
    ranks = []
    for i in range(16):
        path = ("/sys/devices/system/cpu/cpu%d/cpufreq/"
                "amd_pstate_prefcore_ranking" % i)
        try:
            with open(path) as f:
                ranks.append(int(f.read().strip()))
        except (OSError, ValueError):
            continue
    if not ranks:
        _lottery_cache = False
        return None
    avg = sum(ranks) / len(ranks)
    score = _bin_score(avg)
    best = _bin_score(max(ranks))
    worst = _bin_score(min(ranks))
    # 50→stock, 99→-25 mV, in 5 mV steps. Conservative all-core start.
    mag = int(round((score - 50) * 25 / 49 / 5.0)) * 5
    mag = max(0, min(25, mag))
    _lottery_cache = {
        "score": score,
        "best": best,
        "worst": worst,
        "suggest": -mag,
        "avg_raw": avg,
        "best_raw": max(ranks),
        "worst_raw": min(ranks),
        "n": len(ranks),
    }
    return _lottery_cache


def save_lighting(lighting):
    cfg = configparser.ConfigParser()
    cfg["lighting"] = lighting
    os.makedirs(os.path.dirname(LIGHTING_PATH), exist_ok=True)
    with open(LIGHTING_PATH, "w") as f:
        cfg.write(f)


def _follows_theme(lighting):
    if not _theme_mod().is_omarchy():
        return False
    return str(lighting.get("follow_theme", "")).lower() in ("1", "true", "yes")


def apply_lighting(lighting):
    """Apply a lighting dict via z13ctl; return (ok, message)."""
    lighting = dict(lighting)
    if _follows_theme(lighting):
        try:
            c1, c2 = _theme_mod().theme_rgb_pair()
            lighting["color1"] = c1
            lighting["color2"] = c2
        except Exception:
            pass
        if lighting.get("mode") == "off":
            lighting["mode"] = "static"
    device_args = [] if lighting["device"] == "all" \
        else ["--device", lighting["device"]]
    if lighting["mode"] == "off":
        r = z13ctl(["off", *device_args])
        return (r is not None and r.returncode == 0, "Lighting off")
    args = ["apply", "--mode", lighting["mode"],
            "--color", lighting["color1"].lstrip("#"),
            "--brightness", lighting["brightness"], *device_args]
    if lighting["mode"] == "breathe":
        args += ["--color2", lighting["color2"].lstrip("#")]
    if lighting["mode"] not in ("static",):
        args += ["--speed", lighting["speed"]]
    r = z13ctl(args)
    return (r is not None and r.returncode == 0,
            f"Lighting: {lighting['mode']}")


# ── service config ────────────────────────────────────────────────────────────

CONFIG_DEFAULTS = {
    "low_battery": "15",
    "on_ac": "performance",
    "on_battery": "balanced",
    "on_low_battery": "silent",
}


def load_service_config():
    """Read the [service] section of service.conf; return {key: value}."""
    cfg = configparser.ConfigParser()
    cfg.read(CONFIG_PATH)
    out = dict(CONFIG_DEFAULTS)
    if cfg.has_section("service"):
        for key in out:
            try:
                value = cfg.get("service", key).strip()
                if value:
                    out[key] = value
            except configparser.Error:
                pass
    return out


def save_service_config(updates):
    """Rewrite the given [service] keys in service.conf, preserving every
    comment and the other sections (mode recipes). Creates a minimal file if
    none exists. Returns the path written."""
    os.makedirs(os.path.dirname(CONFIG_PATH), exist_ok=True)
    if os.path.exists(CONFIG_PATH):
        with open(CONFIG_PATH) as f:
            lines = f.readlines()
    else:
        lines = ["[service]\n"]
    start = next((i for i, ln in enumerate(lines) if ln.strip() == "[service]"),
                 None)
    if start is None:
        lines.append("\n[service]\n")
        start = len(lines) - 1
    end = next((i for i in range(start + 1, len(lines))
                if lines[i].startswith("[")), len(lines))
    for key, value in updates.items():
        pattern = re.compile(rf"^({re.escape(key)}\s*=\s*).*$")
        for i in range(start + 1, end):
            if pattern.match(lines[i]):
                lines[i] = pattern.sub(lambda m: m.group(1) + value, lines[i])
                break
        else:
            lines.insert(end, f"{key} = {value}\n")
            end += 1
    with open(CONFIG_PATH, "w") as f:
        f.writelines(lines)
    return CONFIG_PATH


# ── status / telemetry parsing ───────────────────────────────────────────────

def _read_sysfs(path):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return None


def _write_sysfs(path, value):
    try:
        with open(path, "w") as f:
            f.write(str(value))
        return True
    except OSError:
        return False


_hwmon = {}


def _hwmon_path(name):
    """Resolve /sys/class/hwmon/* by name; cache until the path disappears."""
    cached = _hwmon.get(name)
    if cached and os.path.isdir(cached):
        if _read_sysfs(os.path.join(cached, "name")) == name:
            return cached
    base = None
    try:
        for entry in os.listdir("/sys/class/hwmon"):
            path = os.path.join("/sys/class/hwmon", entry)
            if _read_sysfs(os.path.join(path, "name")) == name:
                base = path
                break
    except OSError:
        pass
    _hwmon[name] = base
    return base


def fan_curve():
    """Return (points, mode) from asus_custom_fan_curve sysfs.

    points is a list of (temp_C, pwm) tuples; mode is 'custom' or 'auto' ('' if
    the read fails). Falls back to `z13ctl fancurve --get` if sysfs is empty.
    """
    points, mode = [], ""
    base = _hwmon_path("asus_custom_fan_curve")
    if base:
        enable = _read_sysfs(os.path.join(base, "pwm1_enable"))
        mode = {"0": "full", "1": "custom", "2": "auto"}.get(enable or "", "")
        ok = True
        for i in range(1, 9):
            temp = _read_sysfs(os.path.join(base, "pwm1_auto_point%d_temp" % i))
            pwm = _read_sysfs(os.path.join(base, "pwm1_auto_point%d_pwm" % i))
            try:
                points.append((int(temp), int(pwm)))
            except (TypeError, ValueError):
                ok = False
                break
        if ok and len(points) == 8:
            return points, mode
    points, mode = [], mode
    r = z13ctl(["fancurve", "--get"])
    if r is None:
        return points, mode
    for line in r.stdout.splitlines():
        line = line.strip()
        if "mode:" in line and "RPM" in line:
            _, _, mode = line.partition("mode:")
            mode = mode.strip().split(",")[0]
        parts = line.replace("°C", "°C ").split(":")
        if len(parts) >= 2 and parts[0].strip().endswith("°C"):
            temp = parts[0].strip()[:-2]
            pwm = parts[1].split("/")[0].strip()
            try:
                points.append((int(temp), int(pwm)))
            except ValueError:
                continue
    return points, mode


def _amdgpu_ppt_w():
    """Live SoC draw in watts from amdgpu PPT, or None."""
    base = _hwmon_path("amdgpu")
    if not base:
        return None
    raw = (_read_sysfs(os.path.join(base, "power1_average"))
           or _read_sysfs(os.path.join(base, "power1_input")))
    try:
        uw = int(raw)
    except (TypeError, ValueError):
        return None
    if uw <= 0:
        return None
    return int(round(uw / 1_000_000))


def tdp_pl1():
    """Current PL1 in watts (0 if it cannot be read)."""
    raw = _read_sysfs(os.path.join(ASUS_WMI, "ppt_pl1_spl"))
    try:
        return int(raw)
    except (TypeError, ValueError):
        pass
    st = read_status_file()
    tdp = st.get("tdp")
    if isinstance(tdp, int):
        return tdp
    r = z13ctl(["tdp", "--get"])
    if r is None:
        return 0
    for line in r.stdout.splitlines():
        if "PL1" in line and "(" in line:
            try:
                return int(line.split(":")[1].strip())
            except (IndexError, ValueError):
                return 0
    return 0


def read_status_file():
    try:
        with open(STATUS_PATH, encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return {}


class LiveStrip(QWidget):
    """Temp · fan · live/cap watts. Visible on every Settings page."""

    def __init__(self, theme, parent=None):
        super().__init__(parent)
        row = QHBoxLayout(self)
        row.setContentsMargins(0, 2, 0, 2)
        row.setSpacing(22)
        self.temp = self._cell("Temp", theme)
        self.fan = self._cell("Fan", theme)
        self.ppt = self._cell("TDP", theme)
        row.addWidget(self.temp[0], 0)
        row.addWidget(self.fan[0], 0)
        row.addWidget(self.ppt[0], 0)
        row.addStretch(1)
        self._timer = QTimer(self)
        self._timer.timeout.connect(self.refresh)
        self._timer.start(1500)
        self.refresh()

    def _cell(self, title, theme):
        wrap = QWidget()
        box = QHBoxLayout(wrap)
        box.setContentsMargins(0, 0, 0, 0)
        box.setSpacing(8)
        lab = QLabel(title)
        val = QLabel("—")
        muted = QColor(theme["foreground"])
        muted.setAlphaF(0.55)
        lab.setStyleSheet(
            f"color: {muted.name(QColor.NameFormat.HexArgb)}; background: transparent;")
        val.setStyleSheet(
            f"color: {theme['foreground']}; background: transparent; font-weight: 600;")
        box.addWidget(lab)
        box.addWidget(val)
        wrap.setSizePolicy(QSizePolicy.Policy.Maximum, QSizePolicy.Policy.Preferred)
        return wrap, val, lab

    def refresh(self):
        k10 = _hwmon_path("k10temp")
        raw = _read_sysfs(os.path.join(k10, "temp1_input")) if k10 else None
        try:
            self.temp[1].setText("%d°C" % (int(raw) // 1000))
        except (TypeError, ValueError):
            self.temp[1].setText("—")
        asus = _hwmon_path("asus")
        rpm = []
        if asus:
            for i in (1, 2):
                raw = _read_sysfs(os.path.join(asus, "fan%d_input" % i))
                try:
                    rpm.append(int(raw))
                except (TypeError, ValueError):
                    pass
        self.fan[1].setText("%d RPM" % max(rpm) if rpm else "—")
        draw = _amdgpu_ppt_w()
        cap = tdp_pl1()
        if draw is not None and cap:
            self.ppt[1].setText("%dW / %dW" % (draw, cap))
        elif draw is not None:
            self.ppt[1].setText("%dW" % draw)
        elif cap:
            self.ppt[1].setText("%dW" % cap)
        else:
            self.ppt[1].setText("—")


