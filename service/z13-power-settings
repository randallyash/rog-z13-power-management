class LightingTab(QWidget):
    def __init__(self, theme, parent=None):
        super().__init__(parent)
        T = _theme_mod()
        self.theme = theme
        self.lighting = load_lighting()

        layout = QVBoxLayout(self)
        layout.setContentsMargins(4, 0, 4, 0)
        layout.setSpacing(10)

        layout.addWidget(T.SectionHeader("DEVICE", theme))
        self.device_row = T.PillRow(DEVICES, theme)
        self.device_row.set_value(self.lighting["device"])
        layout.addWidget(self.device_row)

        layout.addWidget(T.SectionHeader("EFFECT", theme))
        self.mode_row = T.PillRow(LIGHTING_MODES, theme)
        self.mode_row.set_value(self.lighting["mode"])
        layout.addWidget(self.mode_row)

        layout.addWidget(T.SectionHeader("COLOR 1", theme))
        self.color1_swatches = self._color_row(layout, T, theme)
        layout.addWidget(T.SectionHeader("COLOR 2", theme))
        self.color2_swatches = self._color_row(layout, T, theme)

        layout.addWidget(T.SectionHeader("SPEED", theme))
        self.speed_row = T.PillRow(SPEEDS, theme)
        self.speed_row.set_value(self.lighting["speed"])
        layout.addWidget(self.speed_row)

        layout.addWidget(T.SectionHeader("BRIGHTNESS", theme))
        self.brightness_row = T.PillRow(BRIGHTNESS_LEVELS, theme)
        self.brightness_row.set_value(self.lighting["brightness"])
        layout.addWidget(self.brightness_row)

        buttons = QHBoxLayout()
        buttons.setSpacing(6)
        self.apply_btn = T.Pill("Apply lighting", theme)
        self.apply_btn.setCheckable(False)
        self.apply_btn.clicked.connect(self.on_apply)
        self.off_btn = T.Pill("Turn off", theme)
        self.off_btn.setCheckable(False)
        self.off_btn.clicked.connect(self.on_off)
        buttons.addWidget(self.apply_btn)
        buttons.addWidget(self.off_btn)
        layout.addLayout(buttons)

        self.status = T.StatusLine(theme)
        layout.addWidget(self.status)
        layout.addStretch(1)

        self._set_swatch(self.color1_swatches, self.lighting["color1"])
        self._set_swatch(self.color2_swatches, self.lighting["color2"])

    def _color_row(self, layout, T, theme):
        row = QWidget()
        h = QHBoxLayout(row)
        h.setContentsMargins(0, 0, 0, 0)
        h.setSpacing(4)
        swatches = []
        group = []
        for name, hexval in PRESET_COLORS:
            sw = T.ColorPill(hexval, theme)
            sw.setToolTip(name)
            sw.clicked.connect(lambda _c=False, s=sw, lst=group: self._pick(lst, s))
            swatches.append(sw)
            group.append(sw)
            h.addWidget(sw)
        custom = T.Pill("Custom…", theme)
        custom.setCheckable(False)
        custom.setMaximumWidth(110)
        custom.clicked.connect(lambda _c=False, lst=swatches: self._on_custom(lst))
        h.addWidget(custom)
        h.addStretch(1)
        layout.addWidget(row)
        return swatches

    def _pick(self, swatches, target):
        for sw in swatches:
            sw.setChecked(sw is target)

    def _set_swatch(self, swatches, hexval):
        hexval = hexval.lstrip("#").lower()
        target = None
        for sw in swatches:
            if sw.hexval.lower() == hexval:
                target = sw
        if target is None:
            return
        self._pick(swatches, target)

    def _selected(self, swatches):
        for sw in swatches:
            if sw.isChecked():
                return sw.hexval
        return swatches[0].hexval

    def _on_custom(self, target):
        current = QColor("#" + self._selected(target).lstrip("#"))
        color = QColorDialog.getColor(current, self, "Pick a color")
        if not color.isValid():
            return
        hexval = color.name().lstrip("#")
        custom_sw = target[0]
        custom_sw.set_hex(hexval)
        self._pick(target, custom_sw)
        self.status.set_info(f"Color {hexval} selected — press Apply")

    def _collect(self):
        return {
            "device": self.device_row.value(),
            "mode": self.mode_row.value(),
            "color1": self._selected(self.color1_swatches).lstrip("#"),
            "color2": self._selected(self.color2_swatches).lstrip("#"),
            "speed": self.speed_row.value(),
            "brightness": self.brightness_row.value(),
        }

    def on_apply(self):
        lighting = self._collect()
        save_lighting(lighting)
        ok, msg = apply_lighting(lighting)
        self.status.set_result(ok, msg + " ✓" if ok else
                               f"{msg} — failed (check z13ctl / permissions)")

    def on_off(self):
        lighting = self._collect()
        lighting["mode"] = "off"
        save_lighting(lighting)
        self.mode_row.set_value("off")
        ok, msg = apply_lighting(lighting)
        self.status.set_result(ok, msg + " ✓" if ok else
                               f"{msg} — failed (check z13ctl / permissions)")


class FanTab(QWidget):
    def __init__(self, theme, parent=None):
        super().__init__(parent)
        T = _theme_mod()
        v = QVBoxLayout(self)
        v.setContentsMargins(4, 0, 4, 0)
        v.setSpacing(14)

        self.info = T.Note("", theme)
        v.addWidget(self.info)

        v.addWidget(T.SectionHeader("CURVE POINTS", theme))
        grid = QGridLayout()
        grid.setHorizontalSpacing(10)
        grid.setVerticalSpacing(6)
        temp_h = T.SectionHeader("TEMP (°C)", theme)
        pwm_h = T.SectionHeader("PWM (0–255)", theme)
        grid.addWidget(temp_h, 0, 0)
        grid.addWidget(pwm_h, 0, 1)
        self.temp_spins, self.pwm_spins = [], []
        for i in range(8):
            ts = QSpinBox()
            ts.setRange(30, 100)
            ts.setValue(45 + i * 5)
            ps = QSpinBox()
            ps.setRange(0, 255)
            ps.setValue(40 + i * 20)
            grid.addWidget(ts, i + 1, 0)
            grid.addWidget(ps, i + 1, 1)
            self.temp_spins.append(ts)
            self.pwm_spins.append(ps)
        v.addLayout(grid)

        buttons = QHBoxLayout()
        buttons.setSpacing(6)
        self.fetch_btn = T.Pill("Fetch current", theme)
        self.fetch_btn.setCheckable(False)
        self.fetch_btn.clicked.connect(self.fetch)
        self.apply_btn = T.Pill("Apply curve", theme)
        self.apply_btn.setCheckable(False)
        self.apply_btn.clicked.connect(self.apply)
        self.reset_btn = T.Pill("Reset to auto", theme)
        self.reset_btn.setCheckable(False)
        self.reset_btn.clicked.connect(self.reset)
        buttons.addWidget(self.fetch_btn)
        buttons.addWidget(self.apply_btn)
        buttons.addWidget(self.reset_btn)
        v.addLayout(buttons)

        self.msg = T.StatusLine(theme)
        v.addWidget(self.msg)
        v.addStretch(1)
        self.fetch()

    def fetch(self):
        points, mode = fan_curve()
        if len(points) == 8:
            for i, (temp, pwm) in enumerate(points):
                self.temp_spins[i].setValue(temp)
                self.pwm_spins[i].setValue(pwm)
        pl1 = tdp_pl1()
        extra = (" — above 75 W: every point must be ≥50% PWM and reset is "
                 "refused" if pl1 > 75 else "")
        self.info.setText(f"Fan mode: {mode or 'unknown'}. PL1: {pl1} W{extra}")
        if len(points) == 8:
            self.msg.set_info("Fetched current curve.")
        else:
            self.msg.set_result(False, "Could not read the current fan curve.")

    def _curve_string(self):
        temps = [ts.value() for ts in self.temp_spins]
        pwms = [ps.value() for ps in self.pwm_spins]
        for i in range(1, len(temps)):
            if temps[i] <= temps[i - 1]:
                raise ValueError("Temps must increase left to right.")
        for i in range(1, len(pwms)):
            if pwms[i] < pwms[i - 1]:
                raise ValueError("PWM values must not decrease.")
        if tdp_pl1() > 75 and any(p < 127 for p in pwms):
            raise ValueError("PL1 is above 75 W — every point must be ≥50% "
                             "PWM (127).")
        return ",".join(f"{t}:{p}" for t, p in zip(temps, pwms))

    def apply(self):
        try:
            curve = self._curve_string()
        except ValueError as e:
            self.msg.set_result(False, f"Invalid curve: {e}")
            return
        r = z13ctl(["fancurve", "--set", curve])
        ok = r is not None and r.returncode == 0
        self.msg.set_result(ok, "Fan curve applied. (The daemon re-applies it "
                            "after any profile change.)" if ok else
                            "Failed to apply the fan curve.")

    def reset(self):
        r = z13ctl(["fancurve", "--reset"])
        ok = r is not None and r.returncode == 0
        self.msg.set_result(ok, "Restored firmware auto fan mode." if ok else
                            "Failed to reset — refused above 75 W PL1?")
        self.fetch()


class BatteryTab(QWidget):
    def __init__(self, theme, parent=None):
        super().__init__(parent)
        T = _theme_mod()
        v = QVBoxLayout(self)
        v.setContentsMargins(4, 0, 4, 0)
        v.setSpacing(14)

        v.addWidget(T.SectionHeader("CHARGE LIMIT", theme))
        self.current = T.InfoRow("Current", "—", theme)
        v.addWidget(self.current)

        row = QHBoxLayout()
        row.setSpacing(12)
        self.slider = QSlider(Qt.Orientation.Horizontal)
        self.slider.setRange(40, 100)
        self.slider.setValue(80)
        self.value_label = QLabel("80%")
        self.slider.valueChanged.connect(
            lambda n: self.value_label.setText(f"{n}%"))
        row.addWidget(self.slider, 1)
        row.addWidget(self.value_label)
        v.addLayout(row)

        self.apply_btn = T.Pill("Set charge limit", theme)
        self.apply_btn.setCheckable(False)
        self.apply_btn.clicked.connect(self.apply)
        v.addWidget(self.apply_btn)

        v.addWidget(T.Note(
            "100% removes the limit (charge to full). The limit is set in "
            "ACPI and persists across reboots.", theme))

        self.msg = T.StatusLine(theme)
        v.addWidget(self.msg)
        v.addStretch(1)
        self.refresh()

    def refresh(self):
        r = z13ctl(["batterylimit", "--get"])
        if r is not None and r.stdout.strip():
            try:
                val = int(r.stdout.strip())
                self.slider.setValue(val)
                self.current.set_value(f"{val}%")
                return
            except ValueError:
                pass
        self.current.set_value("unknown")

    def apply(self):
        val = self.slider.value()
        r = z13ctl(["batterylimit", "--set", str(val)])
        ok = r is not None and r.returncode == 0
        self.msg.set_result(ok, f"Charge limit set to {val}%." if ok else
                            "Failed to set the charge limit.")
        self.refresh()


class PowerTab(QWidget):
    def __init__(self, theme, parent=None):
        super().__init__(parent)
        T = _theme_mod()
        v = QVBoxLayout(self)
        v.setContentsMargins(4, 0, 4, 0)
        v.setSpacing(10)

        v.addWidget(T.SectionHeader("DISPLAY", theme))
        self.panel = T.ToggleRow(
            "Panel overdrive",
            "Faster pixel response; may cause slight ghosting",
            theme)
        self.panel.clicked.connect(self.apply_panel)
        v.addWidget(self.panel)

        v.addWidget(T.SectionHeader("FIRMWARE", theme))
        self.boot = T.ToggleRow(
            "Boot sound",
            "Audible POST beep on startup",
            theme)
        self.boot.clicked.connect(self.apply_boot)
        v.addWidget(self.boot)

        self.msg = T.StatusLine(theme)
        v.addWidget(self.msg)
        v.addStretch(1)
        self.refresh()

    def refresh(self):
        r = z13ctl(["paneloverdrive", "--get"])
        if r is not None:
            self.panel.setChecked(r.stdout.strip() == "1")
        r = z13ctl(["bootsound", "--get"])
        if r is not None:
            self.boot.setChecked(r.stdout.strip() == "1")

    def apply_panel(self):
        nxt = not self.panel.isChecked()
        val = "1" if nxt else "0"
        r = z13ctl(["paneloverdrive", "--set", val])
        ok = r is not None and r.returncode == 0
        if ok:
            self.panel.setChecked(nxt)
        self.msg.set_result(ok, "Panel overdrive updated." if ok else
                            "Failed to set panel overdrive.")

    def apply_boot(self):
        nxt = not self.boot.isChecked()
        val = "1" if nxt else "0"
        r = z13ctl(["bootsound", "--set", val])
        ok = r is not None and r.returncode == 0
        if ok:
            self.boot.setChecked(nxt)
        self.msg.set_result(ok, "Boot sound updated." if ok else
                            "Failed to set boot sound.")


class TelemetryTab(QWidget):
    def __init__(self, theme, parent=None):
        super().__init__(parent)
        T = _theme_mod()
        v = QVBoxLayout(self)
        v.setContentsMargins(4, 0, 4, 0)
        v.setSpacing(10)

        v.addWidget(T.SectionHeader("LIVE STATUS", theme))
        self.fields = {}
        for key in ("APU temperature", "Fans", "Profile", "Power", "TDP",
                    "Battery"):
            row = T.InfoRow(key, "—", theme)
            self.fields[key] = row
            v.addWidget(row)
        v.addStretch(1)
        self.timer = QTimer(self)
        self.timer.timeout.connect(self.refresh)
        self.timer.start(2000)
        self.refresh()

    def refresh(self):
        st = z13_status()
        mapping = {"APU temperature": "APU", "Fans": "Fans",
                   "Profile": "Profile", "Power": "Power",
                   "TDP": "TDP", "Battery": "Battery"}
        for key, src in mapping.items():
            if src in st:
                self.fields[key].set_value(st[src])


