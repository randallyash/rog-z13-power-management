    def __init__(self, theme, parent=None):
        super().__init__(parent)
        T = _theme_mod()
        v = QVBoxLayout(self)
        v.setContentsMargins(4, 0, 4, 0)
        v.setSpacing(10)

        v.addWidget(T.SectionHeader("LIVE STATUS", theme))
        self.fields = {}
        for key in ("APU temperature", "Fans", "Profile", "Power", "TDP",
                    "Battery"):
            row = T.InfoRow(key, "—", theme)
            self.fields[key] = row
            v.addWidget(row)
        v.addStretch(1)
        self.timer = QTimer(self)
        self.timer.timeout.connect(self.refresh)

    def showEvent(self, event):
        super().showEvent(event)
        self.refresh()
        self.timer.start(3000)

    def hideEvent(self, event):
        self.timer.stop()
        super().hideEvent(event)

    def refresh(self):
        k10 = _hwmon_path("k10temp")
        if k10:
            raw = _read_sysfs(os.path.join(k10, "temp1_input"))
            try:
                self.fields["APU temperature"].set_value(
                    "%d°C" % (int(raw) // 1000))
            except (TypeError, ValueError):
                pass
        asus = _hwmon_path("asus")
        rpm = []
        if asus:
            for i in (1, 2):
                raw = _read_sysfs(os.path.join(asus, "fan%d_input" % i))
                try:
                    rpm.append(int(raw))
                except (TypeError, ValueError):
                    pass
        curve = _hwmon_path("asus_custom_fan_curve")
        enable = _read_sysfs(os.path.join(curve, "pwm1_enable")) if curve else None
        mode = {"0": "full", "1": "custom", "2": "auto"}.get(enable or "", "")
        if rpm:
            extra = (", mode: %s" % mode) if mode else ""
            self.fields["Fans"].set_value("%d RPM%s" % (max(rpm), extra))
        st = read_status_file()
        profile = st.get("profile") or _read_sysfs(
            "/sys/firmware/acpi/platform_profile")
        if profile:
            self.fields["Profile"].set_value(str(profile))
        if st.get("ac") is True:
            self.fields["Power"].set_value("AC")
        elif st.get("ac") is False:
            self.fields["Power"].set_value("battery")
        else:
            online = _read_sysfs("/sys/class/power_supply/AC0/online")
            if online is not None:
                self.fields["Power"].set_value(
                    "AC" if online == "1" else "battery")
        tdp = st.get("tdp")
        if tdp in (None, ""):
            tdp = tdp_pl1() or None
        draw = _amdgpu_ppt_w()
        if draw is not None and tdp not in (None, "", 0):
            self.fields["TDP"].set_value("%dW / %sW" % (draw, tdp))
        elif draw is not None:
            self.fields["TDP"].set_value("%dW" % draw)
        elif tdp not in (None, "", 0):
            self.fields["TDP"].set_value("%sW" % tdp)
        cap = st.get("capacity")
        if cap is None:
            raw = _read_sysfs(BAT_CAPACITY_PATH)
            try:
                cap = int(raw)
            except (TypeError, ValueError):
                cap = None
        if cap is not None:
            self.fields["Battery"].set_value("%s%%" % cap)


