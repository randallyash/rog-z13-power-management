        self.reset_btn.setCheckable(False)
        self.reset_btn.clicked.connect(self.reset)
        buttons.addWidget(self.fetch_btn)
        buttons.addWidget(self.apply_btn)
        buttons.addWidget(self.reset_btn)
        v.addLayout(buttons)

        self.msg = T.StatusLine(theme)
        v.addWidget(self.msg)
        self._timer = QTimer(self)
        self._timer.timeout.connect(self._live_temp)

    def _on_graph(self):
        self.point.set_value(self.graph.selected_label() or "Drag a point")

    def _live_temp(self):
        k10 = _hwmon_path("k10temp")
        if not k10:
            return
        raw = _read_sysfs(os.path.join(k10, "temp1_input"))
        try:
            self.graph.set_live_temp(int(raw) // 1000)
        except (TypeError, ValueError):
            pass

    def showEvent(self, event):
        super().showEvent(event)
        if not getattr(self, "_loaded", False):
            self._loaded = True
            self.fetch()
        self._live_temp()
        self._timer.start(2000)

    def hideEvent(self, event):
        self._timer.stop()
        super().hideEvent(event)

    def fetch(self):
        points, mode = fan_curve()
        if len(points) == 8:
            self.graph.set_points(points)
        pl1 = tdp_pl1()
        self.graph.set_min_pwm(127 if pl1 > 75 else 0)
        extra = (" — above 75 W every point stays ≥50% and reset is refused"
                 if pl1 > 75 else "")
        self.info.setText(
            "Drag the dots. Fan mode: %s. PL1: %s W%s" % (
                mode or "unknown", pl1, extra))
        if len(points) == 8:
            self.msg.set_info("Fetched current curve.")
        else:
            self.msg.set_result(False, "Could not read the current fan curve.")

    def _curve_string(self):
        points = self.graph.points()
        temps = [t for t, _p in points]
        pwms = [p for _t, p in points]
        for i in range(1, len(temps)):
            if temps[i] <= temps[i - 1]:
                raise ValueError("Temps must increase left to right.")
        for i in range(1, len(pwms)):
            if pwms[i] < pwms[i - 1]:
                raise ValueError("Fan speed must not decrease.")
        if tdp_pl1() > 75 and any(p < 127 for p in pwms):
            raise ValueError("PL1 is above 75 W — every point must be ≥50%.")
        return ",".join("%d:%d" % (t, p) for t, p in points)

    def apply(self):
        try:
            curve = self._curve_string()
        except ValueError as e:
            self.msg.set_result(False, f"Invalid curve: {e}")
            return
        r = z13ctl(["fancurve", "--set", curve])
        ok = r is not None and r.returncode == 0
        self.msg.set_result(ok, "Fan curve applied. (The daemon re-applies it "
                            "after any profile change.)" if ok else
                            "Failed to apply the fan curve.")

    def reset(self):
        r = z13ctl(["fancurve", "--reset"])
        ok = r is not None and r.returncode == 0
        self.msg.set_result(ok, "Restored firmware auto fan mode." if ok else
                            "Failed to reset — refused above 75 W PL1?")
        self.fetch()


