[Unit]
Description=z13-power SMU helper
Requires=z13-power-smu.socket

[Service]
Type=simple
ExecStart=/usr/lib/z13-power/z13-power-smu
StandardInput=socket
StandardOutput=socket
StandardError=journal
User=root
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/sys/kernel/ryzen_smu_drv /run/z13-power
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
