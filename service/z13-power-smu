#!/usr/bin/env python3
"""Root helper for one clamped SMU request. Not a setuid program."""
from __future__ import annotations

import os
import sys

sys.path.insert(0, "/usr/share/z13-power-management")

from z13_power_hw import serve_smu_line  # noqa: E402


def main() -> int:
    if os.geteuid() != 0:
        print("err not root", flush=True)
        return 1
    line = sys.stdin.readline(80)
    if len(line) > 64:
        print("err too long", flush=True)
        return 1
    print(serve_smu_line(line), flush=True)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
