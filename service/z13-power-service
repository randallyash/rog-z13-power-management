_ac_online_path = None
_bat_capacity_path = None


def _discover_power_paths():
    """Resolve AC/battery sysfs files once; retry if a path disappears."""
    global _ac_online_path, _bat_capacity_path
    _ac_online_path = None
    _bat_capacity_path = None
    try:
        names = os.listdir("/sys/class/power_supply")
    except OSError:
        return
    for d in names:
        base = os.path.join("/sys/class/power_supply", d)
        if not os.path.isdir(base):
            continue
        if _ac_online_path is None and (
                d in ("AC", "ACAD", "AC0") or d.startswith("ADP")):
            path = os.path.join(base, "online")
            if os.path.isfile(path):
                _ac_online_path = path
        elif _bat_capacity_path is None and d.startswith("BAT"):
            path = os.path.join(base, "capacity")
            if os.path.isfile(path):
                _bat_capacity_path = path
        if _ac_online_path and _bat_capacity_path:
            return


def read_power():
    """Return (ac_online: bool, capacity: int|None)."""
    if _ac_online_path is None and _bat_capacity_path is None:
        _discover_power_paths()
    ac = False
    capacity = None
    if _ac_online_path:
        try:
            with open(_ac_online_path) as f:
                ac = f.read().strip() == "1"
        except OSError:
            _discover_power_paths()
            if _ac_online_path:
                try:
                    with open(_ac_online_path) as f:
                        ac = f.read().strip() == "1"
                except OSError:
                    pass
    if _bat_capacity_path:
        try:
            with open(_bat_capacity_path) as f:
                capacity = int(f.read().strip())
        except (OSError, ValueError):
            _discover_power_paths()
            if _bat_capacity_path:
                try:
                    with open(_bat_capacity_path) as f:
                        capacity = int(f.read().strip())
                except (OSError, ValueError):
                    pass
    return ac, capacity


def run_diagnose():
    """Run `z13-power diagnose` and return its report text."""
    try:
        r = subprocess.run(
            ["z13-power", "diagnose"],
            capture_output=True, text=True, timeout=30,
        )
        return (r.stdout + r.stderr).strip() or "(no output)"
    except (OSError, subprocess.SubprocessError):
        return "z13-power diagnose failed to run"


def z13ctl(args):
    """Run a z13ctl command; return the CompletedProcess or None."""
    try:
        return subprocess.run(["z13ctl", *args], capture_output=True,
                              text=True, timeout=30)
    except (OSError, subprocess.SubprocessError):
        return None


def ryzen_smu_loaded():
    # Module is named `ryzen_smu`; its sysfs interface is what z13ctl uses.
    return os.path.isdir("/sys/kernel/ryzen_smu_drv")


def firmware_profile():
    """Active asus-wmi firmware profile (quiet/balanced/performance), or ''."""
    try:
        with open("/sys/firmware/acpi/platform_profile") as f:
            return f.read().strip()
    except OSError:
        return ""


_fan_pwm_path = None


def custom_fan_pwm_enable():
    """pwm1_enable on asus_custom_fan_curve (0=full, 1=custom, 2=auto), or ''."""
    global _fan_pwm_path
    if _fan_pwm_path:
        try:
            with open(_fan_pwm_path) as f:
                return f.read().strip()
        except OSError:
            _fan_pwm_path = None
    try:
        for name in os.listdir("/sys/class/hwmon"):
            base = os.path.join("/sys/class/hwmon", name)
            try:
                with open(os.path.join(base, "name")) as f:
                    if f.read().strip() != "asus_custom_fan_curve":
                        continue
                path = os.path.join(base, "pwm1_enable")
                with open(path) as f:
                    val = f.read().strip()
                _fan_pwm_path = path
                return val
            except OSError:
                continue
    except OSError:
        pass
    return ""


def wait_profile_settle(profile, timeout=0.5):
    """Wait until a platform_profile write has landed and fans are in auto.

    The kernel drops custom fan curves on every profile write. --force TDP
    then needs to install its safety curve; that write is refused if the
    previous profile change is still in flight (pwm still auto after the
    curve was written). Two consecutive samples so we don't race the
    handler. Returns False only if the firmware profile never matches.
    """
    deadline = time.monotonic() + timeout
    matched = 0
    while time.monotonic() < deadline:
        if firmware_profile() == profile and custom_fan_pwm_enable() == "2":
            matched += 1
            if matched >= 2:
                return True
        else:
            matched = 0
        time.sleep(0.05)
    return firmware_profile() == profile


def z13ctl_ok(args):
    r = z13ctl(args)
    return r is not None and r.returncode == 0


_last_tdp_args = None
_last_co = None


def apply_mode(mode_def):
    """Run the z13ctl commands described by a mode config dict. Returns True."""
    global _last_tdp_args
    profile = mode_def.get("profile", "balanced")
    tdp_force = str(mode_def.get("tdp_force", "false")).strip().lower() in (
        "true", "yes", "1")
    # Rewriting the same firmware profile still hits platform_profile, which
    # restores stock PPT (performance = 70W) and drops custom fan curves.
    # Skip it when we're already there so MAX is just the TDP write.
    skipped_profile = True
    if profile in ("quiet", "balanced", "performance"):
        if firmware_profile() != profile:
            skipped_profile = False
            if not z13ctl_ok(["profile", "--set", profile]):
                return False
            if tdp_force:
                wait_profile_settle(profile)
    tdp = mode_def.get("tdp", "52 71 70").split()
    args = ["tdp", "--set"]
    if len(tdp) == 1:
        args.append(tdp[0])
    elif len(tdp) >= 3:
        args += [tdp[0], "--pl2", tdp[1], "--pl3", tdp[2]]
    if tdp_force:
        args.append("--force")
    if args != _last_tdp_args:
        if not z13ctl_ok(args):
            return False
        _last_tdp_args = args
    # Fan curve: only touched if the mode defines one (max omits it — reset
    # is refused above 75W PL1, where --force installs its own safety curve).
    # Skip --reset when the firmware profile was already ours and fans are
    # already in auto (a second z13ctl is a no-op). Still reset after a real
    # profile switch, and when leaving Max's --force safety curve (pwm=1).
    fancurve = mode_def.get("fancurve")
    if fancurve is not None:
        fancurve = str(fancurve).strip()
        if fancurve in ("reset", "auto"):
            if not (skipped_profile and custom_fan_pwm_enable() == "2"):
                z13ctl(["fancurve", "--reset"])
        else:
            z13ctl(["fancurve", "--set", fancurve])
    if apply_saved_undervolt():
        return True
    undervolt = str(mode_def.get("undervolt", "reset")).strip()
    val = _parse_co(undervolt)
    if val is None:
        return True
    if val != 0 and not ryzen_smu_loaded():
        return True  # no ryzen_smu — profile/TDP/fancurve still applied
    apply_co(val)
    return True


