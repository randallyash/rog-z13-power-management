#!/usr/bin/env python3
#
# z13-power-service — system tray profile switcher + power profile watcher
# for the ASUS ROG Flow Z13 (GZ302).
#
# Owns all power profile switching and runs the z13ctl commands directly from
# configuration:
#   - tray icon + menu: left-click cycles profiles, right-click opens the menu
#   - "Automatic" mode (default): AC -> on_ac, battery -> on_battery,
#     low battery -> on_low_battery
#   - manual picks apply immediately; unless locked, they clear on the next
#     power-source change and return to Automatic
#   - "Lock profile": a manual pick survives power changes (low battery still
#     forces the safety profile, then restores your locked pick)
#   - "Configure…": opens ~/.config/z13-power/service.conf (fully commented)
#   - notifies (notify-send) on every switch and on external profile changes
#
# Config: ~/.config/z13-power/service.conf — every z13ctl call the service makes
# (profile, TDP limits, fan curve, undervolt) is defined there, per mode.
#
# Usage:  z13-power-service
#
# Requires: z13ctl, notify-send, python-pyqt6, pyudev.

import configparser
import os
import subprocess
import sys

from PyQt6.QtCore import Qt, QPointF, QRectF, QThread, QTimer, pyqtSignal
from PyQt6.QtGui import (QAction, QActionGroup, QColor, QCursor, QIcon,
                         QPainter, QPen, QPolygonF, QPixmap)
from PyQt6.QtWidgets import QApplication, QMenu, QSystemTrayIcon

import pyudev

CONFIG_PATH = os.path.expanduser("~/.config/z13-power/service.conf")

MODES = {
    "performance": "Performance",
    "balanced": "Balanced",
    "silent": "Silent",
    "max": "Max",
    "lowpower": "Low power",
}
MODE_ORDER = ["max", "performance", "balanced", "silent", "lowpower"]
MODE_COLORS = {
    "performance": "#ff3131",
    "balanced": "#2ec4ff",
    "silent": "#3ddc6f",
    "max": "#ff8c00",
    "lowpower": "#ffd23f",
}

DEFAULT_MODES = {
    "performance": {"profile": "performance", "tdp": "75 93 93",
                    "tdp_force": "false", "fancurve": "reset", "undervolt": "reset"},
    "balanced": {"profile": "balanced", "tdp": "52 71 70",
                 "tdp_force": "false", "fancurve": "reset", "undervolt": "reset"},
    "silent": {"profile": "quiet", "tdp": "20 40 40",
               "tdp_force": "false", "fancurve": "reset", "undervolt": "-20"},
    "max": {"profile": "performance", "tdp": "93",
            "tdp_force": "true", "undervolt": "reset"},
    "lowpower": {"profile": "quiet", "tdp": "5",
                 "tdp_force": "false", "fancurve": "reset", "undervolt": "-25"},
}

CONFIG_TEMPLATE = """\
# =============================================================================
#  z13-power — ROG Flow Z13 power profile configuration
#  Read by the z13-power-service tray app. Editing takes effect within ~30s
#  (no restart needed). Opens with the tray menu -> Configure….
#
#  Modes: performance | balanced | silent | max | lowpower
#  Firmware profiles: quiet | balanced | performance
# =============================================================================

[service]
# Battery percent at or below which `on_low_battery` applies (on battery only).
low_battery = 15

# Which mode to apply in each power state (used while the tray is on "Automatic").
on_ac = performance
on_battery = balanced
on_low_battery = silent

# -----------------------------------------------------------------------------
#  [modes.<name>] — what the service runs for each profile mode.
#
#  profile     Firmware profile written to platform_profile (asus-wmi):
#                quiet        — Silent/Eco mode (low power, low noise)
#                balanced     — Balanced mode (default)
#                performance  — Turbo mode (maximum performance)
#
#  tdp         TDP (Package Power Tracking) power limits, in watts.
#                One number  -> all limits set to it,      e.g.  tdp = 93
#                Three       -> PL1 PL2 PL3,               e.g.  tdp = 75 93 93
#              PL1 = sustained (long-term) power cap.
#              PL2 = boost / short-burst power cap.
#              PL3 = peak / emergency burst cap.
#              PL1 is capped at 75 W unless tdp_force = true (hardware max
#              93 W on the GZ302E). PL2/PL3 may go to 93 W without --force.
#
#  tdp_force   true  -> allow PL1 above 75 W (also writes a 50% PWM fan floor
#                       that reaches 100% at 80 C as a safety net).
#              false -> PL1 stays <= 75 W.
#
#  fancurve    reset                     -> firmware auto mode (both fans).
#              auto                      -> same as reset.
#              'T1:S1,T2:S2,...' (8 pts) -> custom curve on both fans. T = temp
#                in C (monotonically increasing); S = speed as PWM 0-255 or a
#                percentage with % (non-decreasing). Formats may be mixed.
#                e.g. 40:30%,50:40%,60:60%,70:75%,80:90%,85:95%,90:98%,95:100%
#              NOTE: the kernel drops custom curves on every power profile
#              change; the z13ctl daemon re-applies within a couple of seconds.
#
#  undervolt   reset   -> CPU stock voltage (0).
#              -1..-40 -> negative Curve Optimizer offset in mV, applied to all
#                cores. Undervolting lowers voltage (less heat, same clocks).
#                Requires the ryzen_smu kernel module (ryzen_smu-dkms-git AUR,
#                amkillam fork for Strix Halo). Without it the undervolt step
#                is skipped while profile/TDP/fancurve still apply. CO values
#                are volatile across reboot/sleep; the z13ctl daemon re-applies
#                them on startup/resume.
# -----------------------------------------------------------------------------

[modes.max]
profile = performance
tdp = 93
tdp_force = true
# No fancurve line: reset is refused above 75W PL1 — the --force safety curve
# (50% PWM floor -> 100% at 80C) stays in effect at 93W.
undervolt = reset

[modes.performance]
profile = performance
tdp = 75 93 93
tdp_force = false
fancurve = reset
undervolt = reset

[modes.balanced]
profile = balanced
tdp = 52 71 70
tdp_force = false
fancurve = reset
undervolt = reset

[modes.silent]
profile = quiet
tdp = 20 40 40
tdp_force = false
fancurve = reset
undervolt = -20

[modes.lowpower]
profile = quiet
tdp = 5
tdp_force = false
fancurve = reset
undervolt = -25
"""


def read_power():
    """Return (ac_online: bool, capacity: int|None)."""
    ac = False
    capacity = None
    for d in os.listdir("/sys/class/power_supply"):
        base = os.path.join("/sys/class/power_supply", d)
        if not os.path.isdir(base):
            continue
        if d in ("AC", "ACAD", "AC0") or d.startswith("ADP"):
            try:
                with open(os.path.join(base, "online")) as f:
                    ac = f.read().strip() == "1"
            except OSError:
                pass
        elif d.startswith("BAT") and capacity is None:
            try:
                with open(os.path.join(base, "capacity")) as f:
                    capacity = int(f.read().strip())
            except OSError:
                pass
    return ac, capacity


def z13_sig():
    """Fingerprint of the applied state: profile label + TDP PL1.

    z13ctl's `profile --get` reports the active (possibly custom) profile
    label, which alone is not enough — combine it with the PL1 power limit so
    real changes (overlay, terminal, button) are detectable.
    """
    profile = ""
    pl1 = ""
    try:
        profile = subprocess.run(
            ["z13ctl", "profile", "--get"],
            capture_output=True, text=True, timeout=5,
        ).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        pass
    try:
        out = subprocess.run(
            ["z13ctl", "tdp", "--get"],
            capture_output=True, text=True, timeout=5,
        ).stdout
        for line in out.splitlines():
            if "PL1" in line:
                pl1 = line.split(":")[-1].strip()
                break
    except (OSError, subprocess.SubprocessError):
        pass
    return f"{profile}|{pl1}"


def z13ctl(args):
    """Run a z13ctl command; return the CompletedProcess or None."""
    try:
        return subprocess.run(["z13ctl", *args], capture_output=True,
                              text=True, timeout=30)
    except (OSError, subprocess.SubprocessError):
        return None


def ryzen_smu_loaded():
    try:
        with open("/proc/modules") as f:
            return "ryzen_smu_drv" in f.read()
    except OSError:
        return False


def apply_mode(mode_def):
    """Run the z13ctl commands described by a mode config dict. Returns True."""
    profile = mode_def.get("profile", "balanced")
    if profile in ("quiet", "balanced", "performance"):
        z13ctl(["profile", "--set", profile])
    tdp = mode_def.get("tdp", "52 71 70").split()
    args = ["tdp", "--set"]
    if len(tdp) == 1:
        args.append(tdp[0])
    elif len(tdp) >= 3:
        args += [tdp[0], "--pl2", tdp[1], "--pl3", tdp[2]]
    if str(mode_def.get("tdp_force", "false")).strip().lower() in ("true", "yes", "1"):
        args.append("--force")
    z13ctl(args)
    # Fan curve: only touched if the mode defines one (max omits it — reset
    # is refused above 75W PL1, where --force installs its own safety curve).
    fancurve = mode_def.get("fancurve")
    if fancurve is not None:
        fancurve = str(fancurve).strip()
        if fancurve in ("reset", "auto"):
            z13ctl(["fancurve", "--reset"])
        else:
            z13ctl(["fancurve", "--set", fancurve])
    undervolt = str(mode_def.get("undervolt", "reset")).strip()
    if undervolt != "reset" and not ryzen_smu_loaded():
        return True  # no ryzen_smu — profile/TDP/fancurve still applied
    if undervolt == "reset":
        z13ctl(["undervolt", "--reset"])
    else:
        z13ctl(["undervolt", "--set", undervolt])
    return True


def notify(summary, body):
    try:
        subprocess.run(
            ["notify-send", "-a", "z13-power", "-i", "preferences-system-power",
             "-u", "normal", "-t", "3000", summary, body],
            capture_output=True, timeout=5,
        )
    except (OSError, subprocess.SubprocessError):
        pass


def load_config():
    cfg = configparser.ConfigParser()
    cfg.read(CONFIG_PATH)
    out = {"low_battery": 15, "on_ac": "performance",
           "on_battery": "balanced", "on_low_battery": "silent", "modes": {}}
    try:
        out["low_battery"] = int(cfg.get("service", "low_battery"))
    except (configparser.Error, ValueError):
        pass
    for key in ("on_ac", "on_battery", "on_low_battery"):
        try:
            value = cfg.get("service", key).strip()
            if value in MODES:
                out[key] = value
        except configparser.Error:
            pass
    for section in cfg.sections():
        if not section.startswith("modes."):
            continue
        name = section[len("modes."):]
        if name not in MODES:
            continue
        mode_def = dict(DEFAULT_MODES[name])
        for key in ("profile", "tdp", "tdp_force", "fancurve", "undervolt"):
            try:
                mode_def[key] = cfg.get(section, key).strip()
            except configparser.Error:
                pass  # keep the default (max has no fancurve by design)
        if mode_def["profile"] not in ("quiet", "balanced", "performance"):
            mode_def["profile"] = DEFAULT_MODES[name]["profile"]
        out["modes"][name] = mode_def
    return out


def ensure_config():
    """Write the fully-commented default config if none exists yet."""
    if os.path.exists(CONFIG_PATH):
        return
    os.makedirs(os.path.dirname(CONFIG_PATH), exist_ok=True)
    with open(CONFIG_PATH, "w") as f:
        f.write(CONFIG_TEMPLATE)


def make_icon(color):
    """ROG-style tray icon: dark tile + angular power bolt, tinted per mode."""
    pm = QPixmap(64, 64)
    pm.fill(Qt.GlobalColor.transparent)
    p = QPainter(pm)
    p.setRenderHint(QPainter.RenderHint.Antialiasing)
    p.setBrush(QColor("#15151a"))
    p.setPen(QPen(QColor("#33333d"), 2))
    p.drawRoundedRect(QRectF(2, 2, 60, 60), 12, 12)
    p.setBrush(QColor(color))
    p.setPen(Qt.PenStyle.NoPen)
    bolt = QPolygonF([
        QPointF(37, 6), QPointF(18, 36), QPointF(30, 36), QPointF(26, 58),
        QPointF(47, 26), QPointF(34, 26), QPointF(43, 6),
    ])
    p.drawPolygon(bolt)
    p.end()
    return QIcon(pm)


class PowerMonitor(QThread):
    """Watches udev power_supply events and re-emits them on the Qt thread."""

    event = pyqtSignal()

    def run(self):
        try:
            ctx = pyudev.Context()
            monitor = pyudev.Monitor.from_netlink(ctx)
            monitor.filter_by(subsystem="power_supply")
        except Exception:
            return  # no udev access — the safety poll timer covers us
        for _ in monitor:
            self.event.emit()


class Service:
    def __init__(self, app):
        self.app = app
        self.cfg = load_config()
        self.automatic = True
        self.manual_mode = None
        self.locked = False
        self.low_latched = False
        ac, _ = read_power()
        self.last_ac = ac
        self.last_sig = z13_sig()
        self._last_applied = None
        self._last_notified = None

        self.tray = QSystemTrayIcon(make_icon(MODE_COLORS["performance"]))
        self.menu = QMenu()

        # Modes + Automatic form an exclusive radio group.
        self.group = QActionGroup(self.menu)
        self.group.setExclusive(True)
        self.mode_actions = {}
        for mode in MODE_ORDER:
            a = QAction(MODES[mode], self.menu, checkable=True)
            a.triggered.connect(lambda _c, m=mode: self.manual(m))
            self.group.addAction(a)
            self.mode_actions[mode] = a
            self.menu.addAction(a)
        self.auto_action = QAction("Automatic", self.menu, checkable=True)
        self.auto_action.triggered.connect(lambda _c: self.choose_automatic())
        self.group.addAction(self.auto_action)
        self.menu.addAction(self.auto_action)

        self.menu.addSeparator()
        self.lock_action = QAction("Lock profile", self.menu, checkable=True)
        self.lock_action.toggled.connect(self.on_lock_toggled)
        self.lock_action.setEnabled(False)
        self.menu.addAction(self.lock_action)

        self.menu.addSeparator()
        configure_a = QAction("Configure\u2026", self.menu)
        configure_a.triggered.connect(self.open_config)
        self.menu.addAction(configure_a)
        quit_a = QAction("Quit", self.menu)
        quit_a.triggered.connect(self.app.quit)
        self.menu.addAction(quit_a)

        self.tray.setContextMenu(self.menu)
        self.tray.activated.connect(self.on_activated)

        self.monitor = PowerMonitor()
        self.monitor.event.connect(self.on_power_event)
        self.monitor.start()

        # 3s: notify on externally-changed profile
        self.poll_timer = QTimer()
        self.poll_timer.timeout.connect(self.on_poll)
        self.poll_timer.start(3000)

        # 30s: safety re-evaluation + config reload in case udev missed an event
        self.power_timer = QTimer()
        self.power_timer.timeout.connect(self.evaluate_power)
        self.power_timer.start(30000)

    def start(self):
        self.evaluate_power()
        self.tray.show()

    def on_activated(self, reason):
        # Right-click: Plasma renders the context menu natively. Left/middle
        # click: cycle to the next profile (menu popups on Wayland are
        # position-unreliable, so cycling gives visible feedback instead).
        if reason in (QSystemTrayIcon.ActivationReason.Trigger,
                      QSystemTrayIcon.ActivationReason.MiddleClick):
            self.cycle()

    def cycle(self):
        cur = self.manual_mode if not self.automatic else self._last_applied
        idx = MODE_ORDER.index(cur) if cur in MODE_ORDER else -1
        nxt = MODE_ORDER[(idx + 1) % len(MODE_ORDER)]
        self.manual(nxt)

    def manual(self, mode):
        """User picked a mode from the tray menu."""
        self.automatic = False
        self.manual_mode = mode
        self.lock_action.setEnabled(True)
        if self.apply(mode, force=True):
            self.update_tray()

    def choose_automatic(self):
        """Return to Automatic (service decides from power state)."""
        self.set_automatic(announce=True)
        self.evaluate_power()

    def set_automatic(self, announce=False):
        changed = not self.automatic
        self.automatic = True
        self.manual_mode = None
        self.locked = False
        self.lock_action.blockSignals(True)
        self.lock_action.setChecked(False)
        self.lock_action.setEnabled(False)
        self.lock_action.blockSignals(False)
        self.update_menu_checks()
        self.update_tray()
        if announce and changed:
            notify("Power profile", "Automatic (per power state)")

    def on_lock_toggled(self, checked):
        self.locked = checked
        self.update_tray()

    def on_power_event(self):
        self.evaluate_power()

    def evaluate_power(self):
        self.cfg = load_config()
        ac, capacity = read_power()
        if ac != self.last_ac:
            self.last_ac = ac
            if not self.automatic and not self.locked:
                # An unlocked manual pick clears on power-source change.
                self.set_automatic()
        low = not ac and capacity is not None and capacity <= self.cfg["low_battery"]
        if low:
            # Safety rule: low battery forces the configured profile.
            self.low_latched = True
            self.apply(self.cfg["on_low_battery"])
            return
        if self.low_latched:
            self.low_latched = False
            if not self.automatic:
                self.apply(self.manual_mode)  # restore locked/manual pick
                return
        if self.automatic:
            self.apply(self.cfg["on_ac"] if ac else self.cfg["on_battery"])

    def apply(self, mode, force=False):
        """Apply a mode; notify only when it actually changed (or force)."""
        mode_def = self.cfg["modes"].get(mode) or DEFAULT_MODES[mode]
        if not apply_mode(mode_def):
            notify("Power profile error", f"Failed to apply '{mode}'")
            return False
        self._last_applied = mode
        self.update_menu_checks()
        self.update_tray()
        if force or mode != self._last_notified:
            notify(f"Power profile: {MODES[mode]}", self._body(mode))
        self._last_notified = mode
        return True

    def _body(self, mode):
        ac, capacity = read_power()
        src = "AC" if ac else ("battery %d%%" % capacity if capacity is not None else "battery")
        return f"{src} \u00b7 {MODES[mode]}"

    def update_menu_checks(self):
        if self.automatic:
            self.auto_action.setChecked(True)
        elif self.manual_mode in self.mode_actions:
            self.mode_actions[self.manual_mode].setChecked(True)
        else:
            # External pick with an unknown mode — nothing checked.
            self.group.setExclusive(False)
            self.auto_action.setChecked(False)
            for a in self.mode_actions.values():
                a.setChecked(False)
            self.group.setExclusive(True)

    def update_tray(self):
        mode = self.manual_mode if not self.automatic else (self._last_applied or "performance")
        color = MODE_COLORS.get(mode, "#b9b9c4")
        self.tray.setIcon(make_icon(color))
        state = "automatic" if self.automatic else ("locked" if self.locked else "manual")
        label = MODES.get(mode, mode)
        self.tray.setToolTip(f"z13-power: {label} ({state})")
        if not self.tray.isVisible():
            self.tray.show()

    def open_config(self):
        ensure_config()
        editor = os.environ.get("VISUAL") or os.environ.get("EDITOR")
        try:
            if editor:
                subprocess.Popen([editor, CONFIG_PATH])
            else:
                subprocess.Popen(["xdg-open", CONFIG_PATH])
        except OSError:
            notify("z13-power", f"Config: {CONFIG_PATH}")

    def on_poll(self):
        sig = z13_sig()
        if not sig:
            return
        if sig != self.last_sig:
            # Changed by something outside the service (overlay, terminal, button).
            self.last_sig = sig
            if not self.locked:
                self.automatic = False
                self.lock_action.setEnabled(True)
            self.update_menu_checks()
            self.update_tray()
            label = sig.split("|")[0]
            notify("Power profile changed", f"Now: {label} (set externally)")


def main():
    ensure_config()
    app = QApplication(sys.argv)
    app.setQuitOnLastWindowClosed(False)
    service = Service(app)
    service.start()
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
