def apply_saved_lighting():
    """Re-apply the lighting settings saved by z13-power-settings (if any)."""
    cfg = configparser.ConfigParser()
    cfg.read(LIGHTING_PATH)
    if not cfg.has_section("lighting"):
        return
    lighting = {key: cfg.get("lighting", key, fallback=default).strip()
                for key, default in (("device", "all"), ("mode", "static"),
                                     ("color1", "FF0000"), ("color2", "000000"),
                                     ("speed", "normal"),
                                     ("brightness", "high"))}
    device_args = [] if lighting["device"] == "all" \
        else ["--device", lighting["device"]]
    if lighting["mode"] == "off":
        z13ctl(["off", *device_args])
        return
    args = ["apply", "--mode", lighting["mode"],
            "--color", lighting["color1"].lstrip("#"),
            "--brightness", lighting["brightness"], *device_args]
    if lighting["mode"] == "breathe":
        args += ["--color2", lighting["color2"].lstrip("#")]
    if lighting["mode"] not in ("static",):
        args += ["--speed", lighting["speed"]]
    z13ctl(args)


def apply_saved_charge_limit():
    """Re-apply the charge cap; ACPI does not keep it across reboot on this unit."""
    cfg = configparser.ConfigParser()
    cfg.read(BATTERY_PATH)
    if not cfg.has_section("battery"):
        return
    try:
        limit = int(cfg.get("battery", "charge_limit").strip())
    except (configparser.Error, ValueError):
        return
    if not (40 <= limit <= 100):
        return
    path = "/sys/class/power_supply/BAT0/charge_control_end_threshold"
    try:
        with open(path) as f:
            if int(f.read().strip()) == limit:
                return
    except (OSError, ValueError):
        pass
    try:
        with open(path, "w") as f:
            f.write(str(limit))
        return
    except OSError:
        z13ctl(["batterylimit", "--set", str(limit)])


_tweaks_mtime = None
_tweaks_val = None
_tweaks_loaded = False


def _parse_co(raw):
    """Curve Optimizer mV (0 stock, negative UV), or None if unusable."""
    raw = str(raw).strip()
    if raw in ("reset", "stock", ""):
        return 0
    try:
        val = int(raw)
    except (TypeError, ValueError):
        return None
    if val > 0:
        val = -val
    return val if -40 <= val <= 0 else None


def load_user_undervolt():
    """Tweaks-tab CO offset in mV (0 stock, negative UV), or None if unset."""
    global _tweaks_mtime, _tweaks_val, _tweaks_loaded
    try:
        mtime = os.path.getmtime(TWEAKS_PATH)
    except OSError:
        mtime = None
    if _tweaks_loaded and mtime == _tweaks_mtime:
        return _tweaks_val
    _tweaks_mtime = mtime
    _tweaks_loaded = True
    if mtime is None:
        _tweaks_val = None
        return None
    cfg = configparser.ConfigParser()
    cfg.read(TWEAKS_PATH)
    try:
        raw = cfg.get("tweaks", "undervolt").strip()
    except (configparser.Error, OSError):
        _tweaks_val = None
        return None
    _tweaks_val = _parse_co(raw)
    return _tweaks_val


def apply_co(val):
    """Set all-core CO in mV (0 = stock). Skip the SMU write if already there."""
    global _last_co
    if val is None:
        return False
    if not ryzen_smu_loaded():
        return False
    if _last_co == val:
        return True
    ok = z13ctl_ok(["undervolt", "--reset"] if val == 0 else
                   ["undervolt", "--set", str(val)])
    if ok:
        _last_co = val
    return ok


def apply_saved_undervolt():
    """Apply the Tweaks slider CO if the user set one. Returns True if used."""
    val = load_user_undervolt()
    if val is None:
        return False
    apply_co(val)
    return True


_cfg_mtime = None
_cfg_cached = None


def load_config(force=False):
    """Parse service.conf; reuse the last parse while mtime is unchanged."""
    global _cfg_mtime, _cfg_cached
    try:
        mtime = os.path.getmtime(CONFIG_PATH)
    except OSError:
        mtime = None
    if not force and _cfg_cached is not None and mtime == _cfg_mtime:
        return _cfg_cached
    cfg = configparser.ConfigParser()
    cfg.read(CONFIG_PATH)
    out = {"low_battery": 15, "on_ac": "performance",
           "on_battery": "balanced", "on_low_battery": "silent", "modes": {}}
    try:
        out["low_battery"] = int(cfg.get("service", "low_battery"))
    except (configparser.Error, ValueError):
        pass
    for key in ("on_ac", "on_battery", "on_low_battery"):
        try:
            value = cfg.get("service", key).strip()
            if value in MODES:
                out[key] = value
        except configparser.Error:
            pass
    for section in cfg.sections():
        if not section.startswith("modes."):
            continue
        name = section[len("modes."):]
        if name not in MODES:
            continue
        mode_def = dict(DEFAULT_MODES[name])
        for key in ("profile", "tdp", "tdp_force", "fancurve", "undervolt"):
            try:
                mode_def[key] = cfg.get(section, key).strip()
            except configparser.Error:
                pass  # keep the default (max has no fancurve by design)
        if mode_def["profile"] not in ("quiet", "balanced", "performance"):
            mode_def["profile"] = DEFAULT_MODES[name]["profile"]
        out["modes"][name] = mode_def
    _cfg_mtime = mtime
    _cfg_cached = out
    return out


def ensure_config():
    """Write the fully-commented default config if none exists yet."""
    if os.path.exists(CONFIG_PATH):
        return
    os.makedirs(os.path.dirname(CONFIG_PATH), exist_ok=True)
    with open(CONFIG_PATH, "w") as f:
        f.write(CONFIG_TEMPLATE)


_TILE_BG = "#15151a"
_TILE_BORDER = "#33333d"
_pixmap_cache = {}


def make_pixmap(color):
    """ROG-style tray tile: dark tile + angular power bolt, tinted per mode."""
    key = (color, _TILE_BG, _TILE_BORDER)
    cached = _pixmap_cache.get(key)
    if cached is not None:
        return cached
    pm = QPixmap(64, 64)
    pm.fill(Qt.GlobalColor.transparent)
    p = QPainter(pm)
    p.setRenderHint(QPainter.RenderHint.Antialiasing)
    p.setBrush(QColor(_TILE_BG))
    p.setPen(QPen(QColor(_TILE_BORDER), 2))
    p.drawRoundedRect(QRectF(2, 2, 60, 60), 12, 12)
    p.setBrush(QColor(color))
    p.setPen(Qt.PenStyle.NoPen)
    bolt = QPolygonF([
        QPointF(37, 6), QPointF(18, 36), QPointF(30, 36), QPointF(26, 58),
        QPointF(47, 26), QPointF(34, 26), QPointF(43, 6),
    ])
    p.drawPolygon(bolt)
    p.end()
    _pixmap_cache[key] = pm
    return pm


def make_icon(color):
    """QIcon wrapper around make_pixmap for the Qt system-tray backend."""
    return QIcon(make_pixmap(color))


def desktop_needs_sni():
    """Tray backend decision: non-KDE Wayland desktops get the own SNI item.

    KDE Plasma renders the tray menu itself; X11's QSystemTrayIcon backend
    emits activated(Context) for right-click. On other Wayland desktops
    (Hyprland/waybar) neither applies — the SNI host calls ContextMenu() and
    the platform theme handles it without the app ever seeing an event — so
    the service registers its own StatusNotifierItem + dbusmenu and lets the
    host render the menu.
    """
    if not os.environ.get("WAYLAND_DISPLAY"):
        return False
    return "kde" not in os.environ.get("XDG_CURRENT_DESKTOP", "").lower()


def z13ctl_socket_path():
    runtime = os.environ.get("XDG_RUNTIME_DIR") or "/tmp"
    return os.path.join(runtime, "z13ctl", "z13ctl.sock")


def _proc_comm(pid):
    try:
        with open(os.path.join("/proc", str(pid), "comm")) as fh:
            return fh.read().strip()
    except OSError:
        return ""


def _proc_environ(pid):
    out = {}
    try:
        with open(os.path.join("/proc", str(pid), "environ"), "rb") as fh:
            chunks = fh.read().split(b"\0")
    except OSError:
        return out
    for item in chunks:
        if b"=" not in item:
            continue
        key, _, val = item.partition(b"=")
        out[key.decode("utf-8", "replace")] = val.decode("utf-8", "replace")
    return out


def _proc_children(pid):
    kids = []
    try:
        tasks = os.listdir(os.path.join("/proc", str(pid), "task"))
    except OSError:
        return kids
    for tid in tasks:
        try:
            with open(os.path.join("/proc", str(pid), "task", tid, "children")) as fh:
                kids.extend(int(x) for x in fh.read().split())
        except OSError:
            continue
    return kids


def gamescope_xdisplay():
    """Nested gamescope Xwayland DISPLAY, or None."""
    host = os.environ.get("DISPLAY")
    try:
        names = os.listdir("/proc")
    except OSError:
        return None
    roots = []
    for name in names:
        if not name.isdigit():
            continue
        if _proc_comm(name) in ("gamescope", "gamescope-wl"):
            roots.append(int(name))
    for root in roots:
        stack = [root]
        seen = set()
        while stack:
            pid = stack.pop()
            if pid in seen:
                continue
            seen.add(pid)
            display = _proc_environ(pid).get("DISPLAY")
            if display and display != host and display.startswith(":"):
                num = display.split(".", 1)[0].lstrip(":")
                if num.isdigit() and os.path.exists("/tmp/.X11-unix/X%s" % num):
                    return display
            stack.extend(_proc_children(pid))
    return None


def panel_pids(*bins):
    """PIDs whose argv basename is one of bins."""
    want = set(bins)
    pids = []
    try:
        names = os.listdir("/proc")
    except OSError:
        return pids
    for name in names:
        if not name.isdigit():
            continue
        try:
            with open(os.path.join("/proc", name, "cmdline"), "rb") as fh:
                argv = [a.decode("utf-8", "replace") for a in fh.read().split(b"\0") if a]
        except OSError:
            continue
        if any(os.path.basename(a) in want for a in argv):
            pids.append(int(name))
    return pids


def settings_pids():
    return panel_pids("z13-power-settings", "z13-power-overlay")


def _kill_pids(pids):
    for pid in pids:
        try:
            os.kill(pid, posix_signal.SIGTERM)
        except OSError:
            pass


def _is_gamescope_class(value):
    """True if a Hyprland class or X11 WM_CLASS names the gamescope window."""
    raw = str(value or "").strip().lower()
    if not raw:
        return False
    parts = []
    for chunk in raw.replace(",", " ").split():
        token = chunk.strip().strip('"').strip("'")
        if token:
            parts.append(token)
    return any(p == "gamescope" or p.startswith("gamescope") for p in parts)


def _hyprland_active_class():
    """Focused window class, or None if Hyprland is not answering."""
    hyprctl = shutil.which("hyprctl") or "/usr/bin/hyprctl"
    if not os.path.isfile(hyprctl) or not os.access(hyprctl, os.X_OK):
        return None
    try:
        r = subprocess.run(
            [hyprctl, "activewindow", "-j"],
            capture_output=True, text=True, timeout=1,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    if r.returncode != 0 or not r.stdout.strip():
        return None
    try:
        data = json.loads(r.stdout)
    except ValueError:
        return None
    if not isinstance(data, dict):
        return None
    return str(data.get("class") or "")


def _x11_active_wm_class():
    """EWMH focused window WM_CLASS on the host DISPLAY."""
    display = os.environ.get("DISPLAY")
    if not display:
        return ""
    xprop = shutil.which("xprop") or "/usr/bin/xprop"
    try:
        root = subprocess.run(
            [xprop, "-display", display, "-root", "_NET_ACTIVE_WINDOW"],
            capture_output=True, text=True, timeout=1,
        )
    except (OSError, subprocess.SubprocessError):
        return ""
    xid = None
    for tok in root.stdout.replace(",", " ").split():
        if tok.lower().startswith("0x"):
            xid = tok
            break
    if not xid or xid.lower() in ("0x0", "0x00"):
        return ""
    try:
        cls = subprocess.run(
            [xprop, "-display", display, "-id", xid, "WM_CLASS"],
            capture_output=True, text=True, timeout=1,
        )
    except (OSError, subprocess.SubprocessError):
        return ""
    return cls.stdout


def _kwin_available():
    """True when org.kde.KWin is on the session bus."""
    gdbus = shutil.which("gdbus")
    if gdbus:
        try:
            r = subprocess.run(
                [gdbus, "call", "--session",
                 "--dest", "org.freedesktop.DBus",
                 "--object-path", "/org/freedesktop/DBus",
                 "--method", "org.freedesktop.DBus.NameHasOwner",
                 "org.kde.KWin"],
                capture_output=True, text=True, timeout=1,
            )
        except (OSError, subprocess.SubprocessError):
            return False
        return r.returncode == 0 and "true" in r.stdout.lower()
    try:
        r = subprocess.run(
            ["busctl", "--user", "status", "org.kde.KWin"],
            capture_output=True, text=True, timeout=1,
        )
    except (OSError, subprocess.SubprocessError):
        return False
    return r.returncode == 0


def _kdotool_active_class():
    exe = shutil.which("kdotool")
    if not exe:
        return None
    try:
        r = subprocess.run(
            [exe, "getactivewindow", "getwindowclassname"],
            capture_output=True, text=True, timeout=1,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    if r.returncode != 0:
        return None
    return r.stdout.strip()


def _gdbus_call(path, method, *args, timeout=1):
    cmd = [
        "gdbus", "call", "--session",
        "--dest", "org.kde.KWin",
        "--object-path", path,
        "--method", method,
    ]
    cmd.extend(args)
    return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)


def _kwin_script_active_class():
    """Ask KWin for workspace.activeWindow.resourceClass via a one-shot script."""
    if not _DBUS_NEXT_OK:
        return None
    gdbus = shutil.which("gdbus")
    if not gdbus:
        return None

    async def _probe():
        bus = await MessageBus().connect()
        future = asyncio.get_running_loop().create_future()

        class Probe(ServiceInterface):
            def __init__(self):
                super().__init__("local.z13power.kwinprobe")

            @method()
            def Result(self, text: "s") -> None:
                if not future.done():
                    future.set_result(str(text or ""))

        bus.export("/z13", Probe())
        dest = bus.unique_name
        js = (
            "(function(){\n"
            "  var w = workspace.activeWindow;\n"
            "  if (w === undefined || w === null) w = workspace.activeClient;\n"
            "  var cls = w ? ('' + w.resourceClass) : '';\n"
            "  callDBus('%s', '/z13', 'local.z13power.kwinprobe', 'Result', cls);\n"
            "})();\n" % dest.replace("\\", "\\\\").replace("'", "\\'")
        )
        fd, path = tempfile.mkstemp(prefix="z13-power-kwin-", suffix=".js")
        script_id = None
        try:
            os.write(fd, js.encode("utf-8"))
            os.close(fd)
            fd = None
            try:
                _gdbus_call(
                    "/Scripting", "org.kde.kwin.Scripting.unloadScript",
                    "z13-power-focus", timeout=1,
                )
            except (OSError, subprocess.SubprocessError):
                pass
            loaded = _gdbus_call(
                "/Scripting", "org.kde.kwin.Scripting.loadScript",
                path, "z13-power-focus", timeout=1,
            )
            if loaded.returncode != 0:
                loaded = _gdbus_call(
                    "/Scripting", "org.kde.kwin.Scripting.loadScript",
                    path, timeout=1,
                )
            if loaded.returncode != 0:
                return None
            digits = "".join(c for c in loaded.stdout if c.isdigit() or c == "-")
            if not digits or int(digits) < 0:
                return None
            script_id = str(int(digits))
            _gdbus_call(
                "/Scripting/Script" + script_id,
                "org.kde.kwin.Script.run", timeout=1,
            )
            return await asyncio.wait_for(future, 1.0)
        finally:
            if script_id:
                try:
                    _gdbus_call(
                        "/Scripting/Script" + script_id,
                        "org.kde.kwin.Script.stop", timeout=1,
                    )
                except (OSError, subprocess.SubprocessError):
                    pass
            try:
                _gdbus_call(
                    "/Scripting", "org.kde.kwin.Scripting.unloadScript",
                    "z13-power-focus", timeout=1,
                )
            except (OSError, subprocess.SubprocessError):
                pass
            if fd is not None:
                try:
                    os.close(fd)
                except OSError:
                    pass
            try:
                os.unlink(path)
            except OSError:
                pass
            try:
                bus.disconnect()
            except Exception:
                pass

    try:
        return asyncio.run(_probe())
    except Exception:
        return None


def _plasma_active_class():
    """Focused window class from KWin, or None if KWin is not in charge.

    Plasma Wayland has no EWMH active window. Prefer kdotool; otherwise a
    one-shot KWin script (same trick kdotool uses).
    """
    if not _kwin_available():
        return None
    cls = _kdotool_active_class()
    if cls is not None:
        return cls
    cls = _kwin_script_active_class()
    if cls is not None:
        return cls
    return ""


def gamescope_host_focused():
    """True when the nested gamescope session is the focused host window.

    Hyprland (Omarchy): hyprctl activewindow class.
    Plasma Wayland: KWin (kdotool or a one-shot script).
    X11 (CachyOS KDE/i3/xfce, …): EWMH _NET_ACTIVE_WINDOW WM_CLASS.
    First compositor that answers wins — Xwayland leftovers must not steal
    the decision while a Wayland app is focused.
    """
    hypr = _hyprland_active_class()
    if hypr is not None:
        return _is_gamescope_class(hypr)
    plasma = _plasma_active_class()
    if plasma is not None:
        return _is_gamescope_class(plasma)
    return _is_gamescope_class(_x11_active_wm_class())


class ButtonWatcher(QThread):
    """Subscribe to z13ctl's Armoury Crate button (gui-toggle / KEY_PROG3).

    The daemon already grabs the key; Hyprland never sees it. We listen on
    the same Unix socket z13gui used. Reconnects if the daemon restarts.
    """

    pressed = pyqtSignal()

    def run(self):
        while not self.isInterruptionRequested():
            if not self._listen_once():
                self.msleep(2000)

    def _listen_once(self):
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            sock.settimeout(2)
            sock.connect(z13ctl_socket_path())
            sock.sendall(b'{"cmd":"subscribe","events":["gui-toggle"]}\n')
            buf = b""
            while b"\n" not in buf:
                chunk = sock.recv(4096)
                if not chunk:
                    return False
                buf += chunk
            line, buf = buf.split(b"\n", 1)
            ack = json.loads(line.decode())
            if not ack.get("ok"):
                return False
            sock.settimeout(1.0)
            while not self.isInterruptionRequested():
                try:
                    chunk = sock.recv(4096)
                except socket.timeout:
                    continue
                if not chunk:
                    return True
                buf += chunk
                while b"\n" in buf:
                    raw, buf = buf.split(b"\n", 1)
                    if not raw:
                        continue
                    try:
                        ev = json.loads(raw.decode())
                    except ValueError:
                        continue
                    if ev.get("event") == "gui-toggle":
                        self.pressed.emit()
        except (OSError, ValueError, json.JSONDecodeError):
            return False
        finally:
            try:
                sock.close()
            except OSError:
                pass
        return True


class PowerMonitor(QThread):
    """Watches udev power_supply events and re-emits them on the Qt thread."""

    event = pyqtSignal()

    def run(self):
        try:
            ctx = pyudev.Context()
            monitor = pyudev.Monitor.from_netlink(ctx)
            monitor.filter_by(subsystem="power_supply")
        except Exception:
            return  # no udev access — the safety poll timer covers us
        for device in monitor:
            name = getattr(device, "sys_name", "")
            # Only the AC adapter matters for power-source changes. USB-C PD
            # ports (ucsi-source-psy-*) and the battery emit power_supply
            # events that must not re-evaluate the power state.
            if name in ("AC", "ACAD", "AC0") or name.startswith("ADP"):
                self.event.emit()


if _DBUS_NEXT_OK:

