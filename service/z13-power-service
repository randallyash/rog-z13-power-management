    class _MenuInterface(ServiceInterface):
        """com.canonical.dbusmenu served by SniTray (waybar renders this)."""

        def __init__(self, owner):
            super().__init__("com.canonical.dbusmenu")
            self._owner = owner

        @dbus_property(access=PropertyAccess.READ)
        def Version(self) -> "i":
            return 3

        @dbus_property(access=PropertyAccess.READ)
        def TextDirection(self) -> "s":
            return "ltr"

        @dbus_property(access=PropertyAccess.READ)
        def Status(self) -> "s":
            return "normal"

        @method()
        def GetLayout(self, parent_id: "i", recursion_depth: "i",
                      property_names: "as") -> "u(ia{sv}av)":
            return [3, self._owner._layout()]

        @method()
        def GetGroupProperties(self, ids: "ai") -> "a(ia{sv})":
            return [[i, self._owner._props_for(i)] for i in ids]

        @method()
        def GetProperty(self, iid: "i", name: "s") -> "v":
            props = self._owner._props_for(iid)
            if name in props:
                return props[name]
            raise DBusError("org.freedesktop.DBus.Error.UnknownProperty",
                            f"no such property: {name}")

        @method()
        def Event(self, iid: "i", event_id: "s", data: "v", timestamp: "u"):
            self._owner._on_menu_event(iid)

        @signal()
        def ItemsPropertiesUpdated(self, changed: "a(ia{sv})",
                                   removed: "ao") -> "a(ia{sv})ao":
            return [changed, removed]


    class SniTray(QObject):
        """Own StatusNotifierItem + dbusmenu tray for non-KDE Wayland.

        On Hyprland/waybar the QSystemTrayIcon backend can't show a menu:
        right-click arrives as an SNI ContextMenu() call that the platform
        theme (plasma-integration/KStatusNotifierItem) handles internally, so
        the app never gets `activated(Context)`. And a manual QMenu.popup()
        can't display on Wayland either, because a windowless service has no
        parent surface for the xdg_popup. So the service registers its own
        item and lets the host render the menu from the exported
        com.canonical.dbusmenu — the same mechanism GTK appindicator apps use.
        """

        mode_clicked = pyqtSignal(str)
        automatic_clicked = pyqtSignal()
        lock_toggled = pyqtSignal(bool)
        diagnose_clicked = pyqtSignal()
        settings_clicked = pyqtSignal()
        quit_clicked = pyqtSignal()
        cycle_requested = pyqtSignal()
        registered = pyqtSignal()
        failed = pyqtSignal(str)
        context_menu_at = pyqtSignal(int, int)

        ID_AUTO = 6
        ID_LOCK = 8
        ID_DIAGNOSE = 10
        ID_SETTINGS = 11
        ID_QUIT = 12
        MODE_IDS = {i + 1: MODE_ORDER[i] for i in range(len(MODE_ORDER))}

        def __init__(self):
            super().__init__()
            self._thread = None
            self._loop = None
            self._bus = None
            self._item = None
            self._menu = None
            self._service_name = None
            self._exported = False
            self._icon_pixmaps = []
            self._tooltip = ""
            self._automatic = True
            self._manual_mode = None
            self._locked = False

        # -- called from the Qt thread -------------------------------------

        def show(self):
            if self._thread is None:
                self._thread = threading.Thread(
                    target=self._run, name="z13-sni", daemon=True)
                self._thread.start()

        def set_icon(self, pixmap):
            self._icon_pixmaps = _argb_pixmaps(pixmap)
            if self._exported:
                self._schedule(self._emit_item_update("NewIcon"))

        def set_tooltip(self, text):
            self._tooltip = text
            if self._exported:
                self._schedule(self._emit_item_update("NewToolTip"))

        def set_state(self, automatic, manual_mode, locked):
            if (automatic, manual_mode, locked) == \
                    (self._automatic, self._manual_mode, self._locked):
                return
            self._automatic = automatic
            self._manual_mode = manual_mode
            self._locked = locked
            changed = [[i, self._props_for(i)]
                       for i in list(self.MODE_IDS) + [self.ID_AUTO, self.ID_LOCK]]
            if self._exported:
                self._schedule(self._emit_menu_update(changed))

        # -- dbus thread -----------------------------------------------------

        def _run(self):
            # Never die silently: report any failure so the service can fall
            # back to the classic Qt tray instead of losing the icon.
            try:
                loop = asyncio.new_event_loop()
                asyncio.set_event_loop(loop)
                self._loop = loop
                loop.run_until_complete(self._setup())
                loop.run_forever()
            except Exception as exc:  # pragma: no cover — transport/loop errors
                self.failed.emit(str(exc) or exc.__class__.__name__)

        async def _setup(self):
            bus = await MessageBus().connect()
            self._bus = bus
            self._item = _ItemInterface(self)
            self._menu = _MenuInterface(self)
            bus.export("/StatusNotifierItem", self._item)
            bus.export("/MenuBar", self._menu)
            for attempt in range(10):
                name = f"org.kde.StatusNotifierItem-{os.getpid()}-{attempt + 1}"
                try:
                    await bus.request_name(name)
                    self._service_name = name
                    break
                except Exception:
                    continue
            else:
                return
            self._exported = True
            # The item is live: the service keeps the Qt fallback tray hidden.
            self.registered.emit()
            # Register with the watcher, retrying until an SNI host (waybar,
            # Omarchy, etc.) is present — it may start after the service.
            # Also re-register when the host disappears (bar refresh): the
            # host forgets every item, and without this the icon stays gone.
            await self._register_with_watcher(bus)
            bus.add_message_handler(self._on_bus_message)
            try:
                await bus.call(Message(
                    destination="org.freedesktop.DBus",
                    path="/org/freedesktop/DBus",
                    interface="org.freedesktop.DBus",
                    member="AddMatch",
                    signature="s",
                    body=["type='signal',sender='org.freedesktop.DBus',"
                          "member='NameOwnerChanged',"
                          "arg0='org.kde.StatusNotifierWatcher'"]))
            except Exception:
                pass
            await self._emit_item_update("NewIcon")
            await self._emit_item_update("NewToolTip")

        def _on_bus_message(self, message):
            if message.member != "NameOwnerChanged":
                return
            if not message.body or message.body[0] != "org.kde.StatusNotifierWatcher":
                return
            new_owner = message.body[2] if len(message.body) > 2 else ""
            if not new_owner or self._loop is None:
                return
            asyncio.run_coroutine_threadsafe(
                self._reregister(), self._loop)

        async def _reregister(self):
            # Must reuse the connection that owns the item. A new bus
            # would advertise a name the watcher cannot talk to.
            if self._bus is None or not self._service_name:
                return
            await self._register_with_watcher(self._bus, name=self._service_name)

        async def _register_with_watcher(self, bus, name=None):
            service = name or self._service_name
            if not service:
                return
            for _ in range(60):
                try:
                    reply = await bus.call(Message(
                        destination="org.kde.StatusNotifierWatcher",
                        path="/StatusNotifierWatcher",
                        interface="org.kde.StatusNotifierWatcher",
                        member="RegisterStatusNotifierItem",
                        signature="s",
                        body=[service]))
                    if reply.message_type != MessageType.ERROR:
                        await self._emit_item_update("NewIcon")
                        await self._emit_item_update("NewToolTip")
                        return
                except Exception:
                    pass
                await asyncio.sleep(1)

        def _schedule(self, coro):
            loop = self._loop
            if loop is not None:
                asyncio.run_coroutine_threadsafe(coro, loop)

        async def _emit_item_update(self, which):
            if not self._exported:
                return
            if which == "NewIcon":
                self._item.NewIcon()
            else:
                self._item.NewToolTip()

        async def _emit_menu_update(self, changed):
            if self._exported:
                self._menu.ItemsPropertiesUpdated(changed, [])

        # -- menu model -------------------------------------------------------

        def _props_for(self, iid):
            if iid in self.MODE_IDS:
                mode = self.MODE_IDS[iid]
                checked = not self._automatic and self._manual_mode == mode
                glyph = MODE_GLYPHS.get(mode, "")
                label = (glyph + "  " if glyph else "") + MODES[mode]
                return {"label": Variant("s", label),
                        "toggle-type": Variant("s", "radio"),
                        "toggle-state": Variant("i", 1 if checked else 0),
                        "enabled": Variant("b", True)}
            if iid == self.ID_AUTO:
                return {"label": Variant("s", "\U000f04e6  Automatic"),
                        "toggle-type": Variant("s", "radio"),
                        "toggle-state": Variant("i", 1 if self._automatic else 0),
                        "enabled": Variant("b", True)}
            if iid == self.ID_LOCK:
                return {"label": Variant("s", "\U000f033e  Lock profile"),
                        "toggle-type": Variant("s", "checkmark"),
                        "toggle-state": Variant("i", 1 if self._locked else 0),
                        "enabled": Variant("b", self._manual_mode is not None)}
            if iid == self.ID_DIAGNOSE:
                return {"label": Variant("s", "\U000f0d7a  Diagnose\u2026"),
                        "enabled": Variant("b", True)}
            if iid == self.ID_SETTINGS:
                return {"label": Variant("s", "\U000f0493  Settings\u2026"),
                        "enabled": Variant("b", True)}
            if iid == self.ID_QUIT:
                return {"label": Variant("s", "\U000f05ad  Quit"),
                        "enabled": Variant("b", True)}
            return {}

        def _layout(self):
            children = []
            for iid in range(1, 13):
                props = {"type": Variant("s", "separator")} if iid in (7, 9) \
                    else self._props_for(iid)
                children.append([iid, props, []])
            wrapped = []
            for child in children:
                wrapped.append(Variant("(ia{sv}av)", child))
            return [0, {"label": Variant("s", "z13-power")}, wrapped]

        def _on_menu_event(self, iid):
            if iid in self.MODE_IDS:
                self.mode_clicked.emit(self.MODE_IDS[iid])
            elif iid == self.ID_AUTO:
                self.automatic_clicked.emit()
            elif iid == self.ID_LOCK:
                self.lock_toggled.emit(not self._locked)
            elif iid == self.ID_DIAGNOSE:
                self.diagnose_clicked.emit()
            elif iid == self.ID_SETTINGS:
                self.settings_clicked.emit()
            elif iid == self.ID_QUIT:
                self.quit_clicked.emit()

        @property
        def tooltip(self):
            return ["", [], self._tooltip, ""]


    def _argb_pixmaps(pixmap):
        """IconPixmap payload in SNI byte order (raw ARGB, A-R-G-B per pixel).

        waybar validates that the blob is exactly w*h*4 bytes and treats it as
        ARGB; Qt's Format_ARGB32 stores little-endian bytes as B,G,R,A, so the
        bytes are reordered.
        """
        img = pixmap.toImage().convertToFormat(QImage.Format.Format_ARGB32)
        data = img.constBits().asstring(img.sizeInBytes())
        out = bytearray(len(data))
        for i in range(img.width() * img.height()):
            j = i * 4
            out[j] = data[j + 3]      # A
            out[j + 1] = data[j + 2]  # R
            out[j + 2] = data[j + 1]  # G
            out[j + 3] = data[j]      # B
        return [[img.width(), img.height(), bytes(out)]]


class Service:
    def __init__(self, app):
        self.app = app
        self.cfg = load_config()
        self.automatic = True
        self.manual_mode = None
        self.locked = False
        self.low_latched = False
        ac, _ = read_power()
        self.last_ac = ac
        self.ac_probe = ac
        self.ac_probe_count = 0
        self.last_fw_profile = firmware_profile()
        self.last_profile = self.last_fw_profile
        self._last_applied = None
        self._last_notified = None
        self._status_payload = None
        self._tray_color = None
        self._tray_tip = None
        # Restore before apply_theme/update_tray, which rewrite status.json.
        self._restore_session()

        # Classic Qt tray — used on KDE Plasma and X11, and as the fallback if
        # the SNI item below fails to register (a silent failure must never
        # cost us the tray icon).
        self.tray = QSystemTrayIcon(make_icon(MODE_COLORS["performance"]))
        self.menu = QMenu()

        # Modes + Automatic form an exclusive radio group.
        self.group = QActionGroup(self.menu)
        self.group.setExclusive(True)
        self.mode_actions = {}
        for mode in MODE_ORDER:
            a = QAction(MODES[mode], self.menu, checkable=True)
            a.triggered.connect(lambda _c, m=mode: self.manual(m))
            self.group.addAction(a)
            self.mode_actions[mode] = a
            self.menu.addAction(a)
        self.auto_action = QAction("Automatic", self.menu, checkable=True)
        self.auto_action.triggered.connect(lambda _c: self.choose_automatic())
        self.group.addAction(self.auto_action)
        self.menu.addAction(self.auto_action)

        self.menu.addSeparator()
        self.lock_action = QAction("Lock profile", self.menu, checkable=True)
        self.lock_action.toggled.connect(self.on_lock_toggled)
        self.lock_action.setEnabled(not self.automatic)
        self.lock_action.blockSignals(True)
        self.lock_action.setChecked(self.locked)
        self.lock_action.blockSignals(False)
        self.menu.addAction(self.lock_action)

        self.menu.addSeparator()
        diagnose_a = QAction("Diagnose\u2026", self.menu)
        diagnose_a.triggered.connect(self.show_diagnose)
        self.menu.addAction(diagnose_a)
        settings_a = QAction("Settings\u2026", self.menu)
        settings_a.triggered.connect(self.open_settings)
        self.menu.addAction(settings_a)
        quit_a = QAction("Quit", self.menu)
        quit_a.triggered.connect(self.app.quit)
        self.menu.addAction(quit_a)

        self.tray.setContextMenu(self.menu)
        self.tray.activated.connect(self.on_activated)

        # Other Wayland desktops (Hyprland/waybar etc.) render tray menus from
        # the SNI dbusmenu protocol, which the Qt backend never exposes, so the
        # service registers its own SNI item there; the Qt tray above stays
        # hidden unless that fails.
        self.sni = None
        self._sni_grace_timer = None
        if desktop_needs_sni():
            if not _DBUS_NEXT_OK:
                notify("z13-power",
                       "python-dbus-next missing — tray menu unavailable")
            else:
                self.sni = SniTray()
                self.sni.mode_clicked.connect(self.manual)
                self.sni.automatic_clicked.connect(self.choose_automatic)
                self.sni.lock_toggled.connect(self.on_lock_toggled)
                self.sni.diagnose_clicked.connect(self.show_diagnose)
                self.sni.settings_clicked.connect(self.open_settings)
                self.sni.quit_clicked.connect(self.app.quit)
                self.sni.cycle_requested.connect(self.cycle)
                self.sni.registered.connect(self.on_sni_registered)
                self.sni.failed.connect(self.on_sni_failed)
                self.sni.context_menu_at.connect(self.on_sni_context_menu)

        self.themed_menu = None
        self._theme = None
        self._theme_mod = None
        self._theme_watcher = None
        try:
            self._theme_mod = _theme_mod()
            self.apply_theme(self._theme_mod.load_theme())
            self._theme_watcher = self._theme_mod.ThemeWatcher(self.app)
            self._theme_watcher.changed.connect(self.reload_theme)
        except Exception:
            self.themed_menu = None

        self.monitor = PowerMonitor()
        self.monitor.event.connect(self.on_power_event)
        self.monitor.start()

        self._gui_toggle_at = 0.0
        self.button_watch = ButtonWatcher()
        self.button_watch.pressed.connect(self.toggle_settings)
        self.button_watch.start()

        # Sysfs poll for firmware profile changes made outside this service.
        self.poll_timer = QTimer()
        self.poll_timer.timeout.connect(self.on_poll)
        self.poll_timer.start(8000)

        # Safety re-evaluation if udev missed an AC event.
        self.power_timer = QTimer()
        self.power_timer.timeout.connect(self.evaluate_power)
        self.power_timer.start(30000)

        os.makedirs(STATE_DIR, exist_ok=True)
        self._cmd_watcher = QFileSystemWatcher(app)
        self._cmd_watcher.addPath(STATE_DIR)
        if os.path.exists(COMMAND_PATH):
            self._cmd_watcher.addPath(COMMAND_PATH)
        self._cmd_watcher.directoryChanged.connect(self._on_command_path)
        self._cmd_watcher.fileChanged.connect(self._on_command_path)

        self._cfg_watcher = QFileSystemWatcher(app)
        cfg_dir = os.path.dirname(CONFIG_PATH)
        if os.path.isdir(cfg_dir):
            self._cfg_watcher.addPath(cfg_dir)
        if os.path.exists(CONFIG_PATH):
            self._cfg_watcher.addPath(CONFIG_PATH)
        self._cfg_watcher.fileChanged.connect(self._on_config_changed)
        self._cfg_watcher.directoryChanged.connect(self._on_config_changed)
        if self.sni is not None and not self.automatic:
            self.sni.set_state(self.automatic, self.manual_mode, self.locked)

    def start(self):
        self.evaluate_power()
        apply_saved_lighting()
        apply_saved_charge_limit()
        apply_saved_undervolt()
        if self.sni is not None:
            self.sni.show()
            # Give the SNI item a grace period; fall back to the classic Qt
            # tray if it never registers (a silent dbus/thread failure must
            # not take the tray icon away).
            self._sni_grace_timer = QTimer()
            self._sni_grace_timer.setSingleShot(True)
            self._sni_grace_timer.timeout.connect(self._sni_grace_expired)
            self._sni_grace_timer.start(15000)
        else:
            self.tray.show()
        QTimer.singleShot(20000, self.startup_diagnose)

    def on_sni_registered(self):
        """The SNI item is live — keep the Qt fallback tray hidden."""
        if self.sni is None:
            return  # already fell back; don't hide the tray that replaced it
        if self._sni_grace_timer is not None:
            self._sni_grace_timer.stop()
        if self.tray.isVisible():
            self.tray.hide()

    def on_sni_failed(self, reason):
        self._fallback_to_qt_tray(reason)

    def _sni_grace_expired(self):
        self._fallback_to_qt_tray("the tray menu backend did not register")

    def _fallback_to_qt_tray(self, reason):
        if self.sni is None:
            return
        if self._sni_grace_timer is not None:
            self._sni_grace_timer.stop()
        self.sni = None
        self.tray.show()
        notify("z13-power tray",
               f"Menu backend unavailable ({reason}); using the fallback tray")

    def startup_diagnose(self):
        """Cheap PATH/sysfs checks — no z13ctl. Full report is Diagnose."""
        fails = []
        if not shutil.which("z13ctl"):
            fails.append("[FAIL] z13ctl: not installed")
        try:
            if grp.getgrnam("users").gr_gid not in os.getgroups():
                fails.append("[FAIL] users group: not a member")
        except (KeyError, OSError):
            fails.append("[FAIL] users group: not a member")
        if not os.path.isfile("/etc/udev/rules.d/99-z13ctl.rules"):
            fails.append("[FAIL] udev rules: missing")
        writable = False
        try:
            root = "/sys/class/platform-profile"
            for name in os.listdir(root):
                path = os.path.join(root, name, "profile")
                if os.path.isfile(path) and os.access(path, os.W_OK):
                    writable = True
                    break
        except OSError:
            pass
        if not writable:
            fails.append("[FAIL] sysfs: platform-profile not writable")
        if fails:
            notify("z13-power: setup problem",
                   " · ".join(fails) + " — run 'z13-power diagnose'")

    def on_activated(self, reason):
        # Qt QSystemTrayIcon path (KDE, or any X11 desktop). On KDE the shell
        # renders the context menu natively; on X11, Qt's own backend emits
        # activated(Context) for right-click (it does NOT on the SNI backend —
        # non-KDE Wayland uses SniTray instead). Left/middle click cycles.
        if reason in (QSystemTrayIcon.ActivationReason.Trigger,
                      QSystemTrayIcon.ActivationReason.MiddleClick):
            self.cycle()
        elif reason == QSystemTrayIcon.ActivationReason.Context:
            if "kde" not in os.environ.get("XDG_CURRENT_DESKTOP", "").lower():
                self.show_menu()

    def on_sni_context_menu(self, x, y):
        if x or y:
            self.show_menu(QPoint(x, y))
        else:
            self.show_menu()

    def apply_theme(self, theme):
        global MODE_COLORS, _TILE_BG, _TILE_BORDER, _pixmap_cache
        self._theme = theme
        MODE_COLORS = self._theme_mod.mode_colors(theme)
        _TILE_BG = theme.get("dark_background", _TILE_BG)
        _TILE_BORDER = theme.get("muted", _TILE_BORDER)
        _pixmap_cache.clear()
        self._tray_color = None
        self._tray_tip = None
        if hasattr(self._theme_mod, "apply_to_tray"):
            self._theme_mod.apply_to_tray(self.app, theme)
        else:
            self._theme_mod.apply_to_app(self.app, theme)
        if self.themed_menu is None:
            self.themed_menu = self._theme_mod.ThemedMenu()
            self._theme_mod.install_click_away(self.themed_menu, self.app)
        self.themed_menu.set_theme(theme)
        self.rebuild_themed_menu()
        self.update_tray()

    def reload_theme(self):
        if self._theme_mod is None:
            return
        try:
            self.apply_theme(self._theme_mod.load_theme())
        except Exception:
            pass

    def rebuild_themed_menu(self):
        if self.themed_menu is None:
            return
        items = [{"kind": "header", "label": "POWER PROFILE"}]
        for mode in MODE_ORDER:
            items.append({
                "label": MODES[mode],
                "glyph": MODE_GLYPHS.get(mode, ""),
                "checked": (not self.automatic and self.manual_mode == mode),
                "callback": lambda m=mode: self.manual(m),
            })
        items.append({
            "label": "Automatic",
            "glyph": "\U000f04e6",
            "checked": self.automatic,
            "callback": self.choose_automatic,
        })
        items.append({"kind": "separator"})
        items.append({
            "label": "Lock profile",
            "glyph": "\U000f033e",
            "checked": self.locked,
            "enabled": self.manual_mode is not None,
            "callback": lambda: self.on_lock_toggled(not self.locked),
        })
        items.append({"kind": "separator"})
        items.append({
            "label": "Diagnose\u2026",
            "glyph": "\U000f0d7a",
            "callback": self.show_diagnose,
        })
        items.append({
            "label": "Settings\u2026",
            "glyph": "\U000f0493",
            "callback": self.open_settings,
        })
        items.append({
            "label": "Quit",
            "glyph": "\U000f05ad",
            "callback": self.app.quit,
        })
        self.themed_menu.set_items(items)

    def show_menu(self, pos=None):
        if pos is None:
            pos = QCursor.pos()
        if pos.isNull() or (pos.x() == 0 and pos.y() == 0):
            screen = self.app.primaryScreen()
            if screen is not None:
                pos = screen.availableGeometry().center()
        self.rebuild_themed_menu()
        if self.themed_menu is not None:
            self.themed_menu.popup(pos)
            return
        self.menu.popup(pos)

    def cycle(self):
        cur = self.manual_mode if not self.automatic else self._last_applied
        idx = MODE_ORDER.index(cur) if cur in MODE_ORDER else -1
        nxt = MODE_ORDER[(idx + 1) % len(MODE_ORDER)]
        self.manual(nxt)

    def manual(self, mode):
        """User picked a mode from the tray menu."""
        self.automatic = False
        self.manual_mode = mode
        if self.sni is not None:
            self.sni.set_state(self.automatic, self.manual_mode, self.locked)
        else:
            self.lock_action.setEnabled(True)
        if self.apply(mode, force=True):
            self.update_tray()

    def choose_automatic(self):
        """Return to Automatic (service decides from power state)."""
        self.set_automatic(announce=True)
        self.evaluate_power()

    def set_automatic(self, announce=False):
        changed = not self.automatic
        self.automatic = True
        self.manual_mode = None
        self.locked = False
        if self.sni is None:
            self.lock_action.blockSignals(True)
            self.lock_action.setChecked(False)
            self.lock_action.setEnabled(False)
            self.lock_action.blockSignals(False)
        self.update_menu_checks()
        self.update_tray()
        if announce and changed:
            notify("Power profile", "Automatic (per power state)")

    def on_lock_toggled(self, checked):
        self.locked = checked
        if self.sni is not None:
            self.sni.set_state(self.automatic, self.manual_mode, self.locked)
        self.update_tray()

    def on_power_event(self):
        self.evaluate_power()

    def evaluate_power(self):
        self.cfg = load_config()
        ac, capacity = read_power()
        if ac != self.last_ac:
            # Hysteresis: require two consistent reads before treating this
            # as a real power-source change. USB-C PD renegotiation can glitch
            # AC0 for a single read; that must not clear an unlocked manual pick.
            if ac == self.ac_probe:
                self.ac_probe_count += 1
            else:
                self.ac_probe = ac
                self.ac_probe_count = 1
            if self.ac_probe_count >= 2:
                self.last_ac = ac
                self.ac_probe_count = 0
                if not self.automatic and not self.locked:
                    # An unlocked manual pick clears on power-source change.
                    self.set_automatic()
        else:
            self.ac_probe = ac
            self.ac_probe_count = 0
        low = not ac and capacity is not None and capacity <= self.cfg["low_battery"]
        if low:
            # Safety rule: low battery forces the configured profile.
            self.low_latched = True
            self.apply(self.cfg["on_low_battery"])
            return
        if self.low_latched:
            self.low_latched = False
            if not self.automatic:
                self.apply(self.manual_mode)  # restore locked/manual pick
                return
        if self.automatic:
            mode = self.cfg["on_ac"] if ac else self.cfg["on_battery"]
            if mode != self._last_applied:
                self.apply(mode)
        elif self.manual_mode and self.manual_mode != self._last_applied:
            self.apply(self.manual_mode, force=True)

    def apply(self, mode, force=False):
        """Apply a mode; notify only when it actually changed (or force)."""
        mode_def = self.cfg["modes"].get(mode) or DEFAULT_MODES[mode]
        if not apply_mode(mode_def):
            notify("Power profile error", f"Failed to apply '{mode}'")
            return False
        self.last_fw_profile = firmware_profile()
        self.last_profile = self.last_fw_profile or mode_def.get("profile", "")
        self._last_applied = mode
        self.update_menu_checks()
        self.update_tray()
        if force or mode != self._last_notified:
            notify(f"Power profile: {MODES[mode]}", self._body(mode))
        self._last_notified = mode
        return True

    def _body(self, mode):
        ac, capacity = read_power()
        src = "AC" if ac else ("battery %d%%" % capacity if capacity is not None else "battery")
        return f"{src} \u00b7 {MODES[mode]}"

    def update_menu_checks(self):
        if self.themed_menu is not None and self.themed_menu.isVisible():
            self.rebuild_themed_menu()
        if self.sni is not None:
            self.sni.set_state(self.automatic, self.manual_mode, self.locked)
            return
        if self.automatic:
            self.auto_action.setChecked(True)
        elif self.manual_mode in self.mode_actions:
            self.mode_actions[self.manual_mode].setChecked(True)
        else:
            # External pick with an unknown mode — nothing checked.
            self.group.setExclusive(False)
            self.auto_action.setChecked(False)
            for a in self.mode_actions.values():
                a.setChecked(False)
            self.group.setExclusive(True)

    def update_tray(self):
        mode = self.manual_mode if not self.automatic else (self._last_applied or "performance")
        color = MODE_COLORS.get(mode, "#b9b9c4")
        state = "automatic" if self.automatic else ("locked" if self.locked else "manual")
        label = MODES.get(mode, mode)
        self.write_status(mode)
        if color != self._tray_color:
            self._tray_color = color
            if self.sni is not None:
                self.sni.set_icon(make_pixmap(color))
            else:
                self.tray.setIcon(make_icon(color))
        tip = f"z13-power: {label} ({state})"
        if tip != self._tray_tip:
            self._tray_tip = tip
            if self.sni is not None:
                self.sni.set_tooltip(tip)
            else:
                self.tray.setToolTip(tip)
        if self.sni is None and not self.tray.isVisible():
            self.tray.show()

    def _mode_pl1(self, mode):
        mode_def = self.cfg["modes"].get(mode) or DEFAULT_MODES.get(mode) or {}
        parts = str(mode_def.get("tdp", "")).split()
        if parts and parts[0].lstrip("-").isdigit():
            return int(parts[0])
        return None

    def _restore_session(self):
        """Keep Automatic off across login if the user left it off."""
        try:
            with open(STATUS_PATH) as fh:
                data = json.load(fh)
        except (OSError, ValueError, TypeError):
            return
        if data.get("automatic") is not False:
            return
        mode = data.get("mode")
        if mode not in MODE_ORDER:
            return
        self.automatic = False
        self.manual_mode = mode
        self.locked = bool(data.get("locked"))

    def write_status(self, mode=None):
        mode = mode or (self.manual_mode if not self.automatic else (self._last_applied or "performance"))
        ac, capacity = read_power()
        payload = {
            "mode": mode,
            "label": MODES.get(mode, mode),
            "automatic": bool(self.automatic),
            "locked": bool(self.locked),
            "ac": bool(ac),
            "capacity": capacity,
            "tdp": self._mode_pl1(mode),
            "profile": self.last_profile or self.last_fw_profile or "",
        }
        if payload == self._status_payload:
            return
        self._status_payload = payload
        try:
            os.makedirs(STATE_DIR, exist_ok=True)
            tmp = STATUS_PATH + ".tmp"
            with open(tmp, "w") as fh:
                json.dump(payload, fh)
            os.replace(tmp, STATUS_PATH)
        except OSError:
            pass

    def _on_config_changed(self, _path=""):
        if os.path.exists(CONFIG_PATH) and CONFIG_PATH not in self._cfg_watcher.files():
            self._cfg_watcher.addPath(CONFIG_PATH)
        self.cfg = load_config(force=True)
        self.evaluate_power()

    def _on_command_path(self, _path=""):
        if os.path.exists(COMMAND_PATH) and COMMAND_PATH not in self._cmd_watcher.files():
            self._cmd_watcher.addPath(COMMAND_PATH)
        self.handle_command()

    def handle_command(self):
        try:
            with open(COMMAND_PATH) as fh:
                data = json.load(fh)
        except (OSError, ValueError):
            return
        try:
            os.remove(COMMAND_PATH)
        except OSError:
            pass
        op = str(data.get("op") or "")
        if op == "mode":
            mode = str(data.get("mode") or "")
            if mode in MODE_ORDER:
                self.manual(mode)
        elif op == "automatic":
            self.choose_automatic()
        elif op == "lock":
            locked = data.get("locked")
            if locked is None:
                locked = not self.locked
            if not self.automatic:
                self.on_lock_toggled(bool(locked))
        elif op == "settings":
            self.toggle_settings()
        elif op == "settings-open":
            self.open_settings()

    def toggle_settings(self):
        """Armoury Crate button: open, press again to close.

        In a focused gamescope window (Hyprland, Plasma Wayland, or X11),
        toggle the slim overlay on its nested Xwayland. On the desktop,
        toggle full settings — even if a game is still running in the
        background.
        """
        now = time.monotonic()
        if now - self._gui_toggle_at < 0.08:
            return
        self._gui_toggle_at = now
        if gamescope_xdisplay() and gamescope_host_focused():
            pids = panel_pids("z13-power-overlay")
            if pids:
                _kill_pids(pids)
                return
            self._open_gamescope_overlay()
            return
        pids = panel_pids("z13-power-settings")
        if pids:
            _kill_pids(pids)
            return
        self.open_settings()

    def _open_gamescope_overlay(self):
        gs = gamescope_xdisplay()
        if not gs:
            return False
        local = os.path.expanduser("~/.local/bin/z13-power-overlay")
        cmd = local if os.access(local, os.X_OK) else "z13-power-overlay"
        env = os.environ.copy()
        env["DISPLAY"] = gs
        env.pop("WAYLAND_DISPLAY", None)
        env["QT_QPA_PLATFORM"] = "xcb"
        env["Z13_GAMESCOPE"] = "1"
        try:
            subprocess.Popen([cmd], env=env)
            return True
        except OSError:
            return False

    def open_settings(self):
        """Tray / Settings… — always the host settings window."""
        if panel_pids("z13-power-settings"):
            return
        local = os.path.expanduser("~/.local/bin/z13-power-settings")
        cmd = local if os.access(local, os.X_OK) else "z13-power-settings"
        try:
            subprocess.Popen([cmd])
        except OSError:
            notify("z13-power", "z13-power-settings not found in PATH")

    def show_diagnose(self):
        from PyQt6.QtWidgets import QMessageBox
        box = QMessageBox()
        box.setWindowTitle("z13-power diagnose")
        box.setText(run_diagnose())
        if self._theme is not None:
            box.setStyleSheet(self._theme_mod.stylesheet(self._theme))
        box.exec()

    def on_poll(self):
        fw = firmware_profile()
        if not fw or fw == self.last_fw_profile:
            return
        expected = None
        if self._last_applied:
            mode_def = self.cfg["modes"].get(self._last_applied) or DEFAULT_MODES.get(self._last_applied)
            if mode_def:
                expected = mode_def.get("profile")
        self.last_fw_profile = fw
        if expected and fw == expected:
            return
        # Firmware profile changed outside this service (overlay, terminal, button).
        self.last_profile = fw
        if not self.locked:
            self.automatic = False
            if self.sni is not None:
                self.sni.set_state(self.automatic, self.manual_mode, self.locked)
            else:
                self.lock_action.setEnabled(True)
        self.update_menu_checks()
        self.update_tray()
        notify("Power profile changed", f"Now: {fw} (set externally)")


def main():
    ensure_config()
    app = QApplication(sys.argv)
    app.setApplicationName("z13-power")
    app.setDesktopFileName("z13-power")
    app.setQuitOnLastWindowClosed(False)
    try:
        theme = _theme_mod()
        if hasattr(theme, "apply_to_tray"):
            theme.apply_to_tray(app)
        else:
            app.setStyle("Fusion")
    except Exception:
        pass
    service = Service(app)
    service.start()
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
