# KDE Plasma 6 PowerDevil profile — ROG Flow Z13 power automation.
#
# This file maps power states to the z13 profile scripts. install.sh copies
# this into ~/.config/powerdevilrc, replacing %HOME% with your home directory.
#
# IMPORTANT: Do NOT set [AC][Profile] / [Battery][Profile] in KDE's own power
# management. KDE's built-in profile switching would write platform_profile
# directly and race the scripts. Let the scripts own the profile entirely.
#
# KDE GUI equivalent: System Settings -> Power Management -> Profiles
#   AC profile     -> Run Script -> %HOME%/.local/bin/z13performance
#   Battery        -> Run Script -> %HOME%/.local/bin/z13balanced
#   Low Battery    -> Run Script -> %HOME%/.local/bin/z13silent

[AC][Display]
TurnOffDisplayIdleTimeoutSec=900
TurnOffDisplayIdleTimeoutWhenLockedSec=-2

[AC][RunScript]
ProfileLoadCommand=%HOME%/.local/bin/z13performance

[Battery][Display]
DimDisplayIdleTimeoutSec=300
TurnOffDisplayIdleTimeoutSec=1800
TurnOffDisplayIdleTimeoutWhenLockedSec=-2

[Battery][RunScript]
ProfileLoadCommand=%HOME%/.local/bin/z13balanced

[LowBattery][RunScript]
ProfileLoadCommand=%HOME%/.local/bin/z13silent
