# KDE Plasma 6 PowerDevil — display/DPMS settings only.
# Power profile switching is owned by the z13-power service (system tray);
# KDE Run Script hooks are intentionally not used.

[AC][Display]
TurnOffDisplayIdleTimeoutSec=900
TurnOffDisplayIdleTimeoutWhenLockedSec=-2

[Battery][Display]
DimDisplayIdleTimeoutSec=300
TurnOffDisplayIdleTimeoutSec=1800
TurnOffDisplayIdleTimeoutWhenLockedSec=-2
